{
  "name": "@yorozu/help-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only MCP server that helps an AI agent set up, configure and use Yorozu, from the repository's own docs and code.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "yorozu-help-mcp": "src/stdio.ts"
  },
  "exports": {
    "./fetch": "./src/fetch.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/stdio.ts",
    "start:http": "node src/http.ts",
    "generate": "node scripts/generate.ts",
    "check": "node scripts/generate.ts --check",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.2"
  }
}
