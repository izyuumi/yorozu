{
  "sourceLanguage": "en",
  "strings": {
    "Keep your iPhone nearby.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu iPhone cerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneを近くに置いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone을 가까이 두세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将 iPhone 放在附近。"
          }
        }
      }
    },
    "No chats yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay chats"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットはまだありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 채팅이 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无聊天"
          }
        }
      }
    },
    "Not sent. Try again": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No enviado. Reintentar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未送信。再試行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내지 못함. 다시 시도"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发送。重试"
          }
        }
      }
    },
    "Open Yorozu on your iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Yorozu en tu iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでYorozuを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 Yorozu를 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iPhone 上打开 Yorozu。"
          }
        }
      }
    },
    "Reply": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复"
          }
        }
      }
    },
    "Saved on iPhone. It sends when your Mac is reachable.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en el iPhone. Se enviará cuando tu Mac esté disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneに保存しました。Macに接続できると送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에 저장했습니다. Mac에 연결되면 전송됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存在 iPhone 上。连接到 Mac 后将会发送。"
          }
        }
      }
    },
    "Sent": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信済み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보냄"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送"
          }
        }
      }
    },
    "Yorozu": {
      "shouldTranslate": false
    },
    "iPhone not reachable": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone no disponible"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneに接続できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에 연결할 수 없음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 iPhone"
          }
        }
      }
    }
  },
  "version": "1.0"
}