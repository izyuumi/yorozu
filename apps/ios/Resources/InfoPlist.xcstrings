    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu saves pictures to your library when you ask it to."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozuが依頼に応じて写真をライブラリに保存します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu 会在你要求时将图片保存到你的图库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu 會在你要求時將圖片儲存到你的圖庫。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu는 요청하면 사진을 보관함에 저장합니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu guarda imágenes en tu fototeca cuando se lo pides."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu enregistre des images dans votre photothèque lorsque vous le demandez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu sichert Bilder in deiner Mediathek, wenn du darum bittest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Yorozu salva imagens na sua fototeca quando você pede."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu turns what you say into a message, on this device, when you use voice input."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力を使うと、話した内容をこのデバイス上でメッセージにします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用语音输入时，Yorozu 会在此设备上把你说的话转为信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用語音輸入時，Yorozu 會在此裝置上把你說的話轉為訊息。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 입력을 사용하면 Yorozu가 이 기기에서 말한 내용을 메시지로 바꿉니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando usas la entrada de voz, Yorozu convierte lo que dices en un mensaje, en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec la saisie vocale, Yorozu transforme ce que vous dites en message, sur cet appareil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Spracheingabe macht Yorozu aus dem Gesagten eine Nachricht, auf diesem Gerät."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a entrada de voz, o Yorozu transforma o que você diz em uma mensagem, neste dispositivo."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu connects directly to your host on the same network, for faster messages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozuが同じネットワーク上のホストに直接接続し、メッセージをより速くやり取りします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu 会直接连接同一网络中的主机，让信息更快送达。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu 會直接連線同一網路中的主機，讓訊息更快送達。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu는 같은 네트워크에 있는 호스트에 직접 연결해 메시지를 더 빠르게 주고받습니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu se conecta directamente con tu anfitrión en la misma red, para que los mensajes vayan más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu se connecte directement à votre hôte sur le même réseau, pour des messages plus rapides."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu verbindet sich direkt mit deinem Host im selben Netzwerk, für schnellere Nachrichten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Yorozu se conecta diretamente ao seu host na mesma rede, para mensagens mais rápidas."
          }
        }
      }
    }
  },
  "version" : "1.0"
