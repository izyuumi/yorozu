    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu scans the pairing QR code shown by the host, and takes photos you choose to send in a message."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu escanea el código QR de enlace que muestra el anfitrión y hace las fotos que decidas enviar en un mensaje."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozuはホストに表示されたペアリング用QRコードをスキャンし、メッセージで送る写真を撮影します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu는 호스트에 표시된 페어링 QR 코드를 스캔하고, 메시지로 보낼 사진을 촬영합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu 会扫描主机显示的配对二维码，并拍摄你选择在消息中发送的照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu 會掃描主機顯示的配對 QR 碼，並拍攝你選擇在訊息中傳送的照片。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu scanne le code QR de jumelage affiché par l’hôte et prend les photos que vous choisissez d’envoyer dans un message."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu scannt den vom Host angezeigten Kopplungs-QR-Code und nimmt Fotos auf, die du in einer Nachricht senden möchtest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Yorozu escaneia o código QR de emparelhamento mostrado pelo host e tira as fotos que você escolher enviar em uma mensagem."
          }
        }
      }
    },
