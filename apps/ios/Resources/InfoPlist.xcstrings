    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu saves pictures to your library when you ask it to."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozuが依頼に応じて写真をライブラリに保存します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu 会在你要求时将图片保存到你的图库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu 會在你要求時將圖片儲存到你的圖庫。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu는 요청하면 사진을 보관함에 저장합니다."
          }
        },
        "es" : {
