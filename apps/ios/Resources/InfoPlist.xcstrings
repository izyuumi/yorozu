            "state": "new",
            "value": "Yorozu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu"
          }
        }
      }
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "YorozuIOS"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YorozuIOS"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu connects straight to your Mac on the same network when Direct connection is on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接接続がオンのとき、Yorozuは同じネットワーク上のMacに直接接続します。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu scans the pairing QR code shown by your Mac, and takes photos you choose to send in a message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu escanea el código QR de emparejamiento que muestra tu Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YorozuはMacに表示されたペアリング用QRコードをスキャンし、メッセージで送る写真を撮影します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu는 Mac에 표시된 페어링 QR 코드를 스캔합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu 会扫描 Mac 上显示的配对二维码。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu saves pictures to your library when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼に応じて写真をライブラリに保存します。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
