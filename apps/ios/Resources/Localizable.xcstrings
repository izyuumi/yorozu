    "Waiting for Wi-Fi. The model downloads on Wi-Fi so it doesn’t use cellular data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten auf WLAN. Das Modell wird über WLAN geladen, damit keine Mobilfunkdaten verbraucht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando Wi-Fi. El modelo se descarga por Wi-Fi para no usar datos móviles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente du Wi-Fi. Le modèle se télécharge en Wi-Fi pour ne pas utiliser de données cellulaires."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fiを待っています。モバイルデータ通信を使わないよう、モデルはWi-Fiでダウンロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi를 기다리는 중입니다. 셀룰러 데이터를 쓰지 않도록 모델은 Wi-Fi로 다운로드합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
