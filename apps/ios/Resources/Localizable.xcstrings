      }
    },
    "This code was already used or has expired. Scan the new code on the Mac." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコードは使用済みか、有効期限が切れています。Mac に表示された新しいコードをスキャンしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此代码已被使用或已过期。请扫描 Mac 上的新代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此代碼已被使用或已過期。請掃描 Mac 上的新代碼。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 코드는 이미 사용되었거나 만료되었습니다. Mac에 표시된 새 코드를 스캔하십시오."
          }
        },
        "es" : {
          "stringUnit" : {
