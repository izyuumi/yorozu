    "On the host, open Settings › Devices › Pair a Client Device and scan its QR code." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストで「設定」›「デバイス」›「クライアント端末をペアリング」を開き、QRコードをスキャンしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在主机上打开“设置”›“设备”›“配对客户端设备”，然后扫描其二维码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在主機上打開「設定」›「裝置」›「配對用戶端裝置」，然後掃描其 QR 碼。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트에서 설정 › 기기 › 클라이언트 기기 페어링을 열고 QR 코드를 스캔하십시오."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el anfitrión, abre Ajustes › Dispositivos › Enlazar un dispositivo cliente y escanea su código QR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l’hôte, ouvrez Réglages › Appareils › Jumeler un appareil client et scannez son code QR."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne auf dem Host Einstellungen › Geräte › Client-Gerät koppeln und scanne den QR-Code."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No host, abra Ajustes › Dispositivos › Emparelhar um dispositivo cliente e escaneie o código QR."
          }
        }
      }
    },
    "On the new iPhone, iPad or Mac, scan this code with the camera or in Yorozu, or open the link there." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい iPhone、iPad、Mac で、カメラか Yorozu でこのコードを読み取るか、そこでリンクを開いてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在新的 iPhone、iPad 或 Mac 上，用相机或在 Yorozu 中扫描此代码，或在其上打开链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在新的 iPhone、iPad 或 Mac 上，用相機或在 Yorozu 中掃描此代碼，或在其上打開連結。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 iPhone, iPad 또는 Mac에서 카메라나 Yorozu로 이 코드를 스캔하거나 해당 기기에서 링크를 여십시오."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el nuevo iPhone, iPad o Mac, escanea este código con la cámara o en Yorozu, o abre allí el enlace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur le nouvel iPhone, iPad ou Mac, scannez ce code avec l’appareil photo ou dans Yorozu, ou ouvrez-y le lien."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne diesen Code auf dem neuen iPhone, iPad oder Mac mit der Kamera oder in Yorozu, oder öffne dort den Link."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No novo iPhone, iPad ou Mac, escaneie este código com a câmera ou no Yorozu, ou abra o link lá."
          }
        }
      }
    },
