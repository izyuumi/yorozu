          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay ist nicht erreichbar. Prüfe die Verbindung und scanne erneut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o relay. Verifique a conexão e escaneie de novo."
          }
        }
      }
    },
