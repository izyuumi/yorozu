    "Update Yorozu on your iPhone and iPad, then pair them again with Settings › Add a Device…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请更新 iPhone 和 iPad 上的 Yorozu，然后通过“设置”›“添加设备…”重新配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請更新 iPhone 和 iPad 上的 Yorozu，然後透過「設定」›「加入裝置⋯」重新配對。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone과 iPad의 Yorozu를 업데이트한 다음 설정 › 기기 추가…에서 다시 페어링하십시오."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza Yorozu en tu iPhone y iPad y vuelve a enlazarlos en Ajustes › Añadir un dispositivo…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour Yorozu sur votre iPhone et iPad, puis jumelez-les à nouveau via Réglages › Ajouter un appareil…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere Yorozu auf deinem iPhone und iPad und kopple sie dann erneut über Einstellungen › Gerät hinzufügen …"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize o Yorozu no seu iPhone e iPad e emparelhe-os de novo em Ajustes › Adicionar um dispositivo…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone と iPad の Yorozu をアップデートしてから、設定 › デバイスを追加… でもう一度ペアリングしてください。"
          }
        }
      }
    },
    "“%@” is %@. Yorozu sends files up to %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
