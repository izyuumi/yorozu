          }
        }
      }
    },
    "Couldn’t reach the relay. Check the connection and scan again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リレーに接続できませんでした。接続を確認して、もう一度スキャンしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接中继。请检查网络连接并重新扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線中繼。請檢查網路連線並重新掃描。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "릴레이에 연결할 수 없습니다. 연결을 확인하고 다시 스캔하십시오."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
