    },
    "Use Yorozu here while a host Mac you already set up does the work. Needs only its pairing code.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定済みのホストMacで作業を実行し、このMacでYorozuを使います。ホストのペアリングコードだけで接続できます。"
          }
        }
      }
    },
    "Use the pairing code below to connect your device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
