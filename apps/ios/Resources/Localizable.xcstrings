    "Yorozu Setup": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuの設定"
          }
        }
      }
    },
    "Yorozu will remove pairing keys, counters, cached chats, and queued messages from this Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacからペアリング鍵、カウンター、キャッシュ済みチャット、待機中のメッセージを削除します。"
          }
        }
      }
    },
    "Yorozu will restart after this Mac’s agents finish, any postponement expires, and the 10-second countdown completes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのエージェントが終了し、延期期間と10秒のカウントダウンが完了すると、Yorozuが再起動します。"
          }
        }
      }
    },
    "Yorozu, connected": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu、接続中"
          }
