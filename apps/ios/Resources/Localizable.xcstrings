    "Beta builds have the newest changes before a stable release. Turned off, Yorozu waits for the next stable release." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベータ版には、安定版より先に最新の変更が入ります。オフにすると、次の安定版を待ちます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta 版会在稳定版发布前提供最新更改。关闭后，Yorozu 会等待下一个稳定版。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta 版會在穩定版發布前提供最新變更。關閉後，Yorozu 會等待下一個穩定版。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "베타 빌드에는 안정 버전보다 먼저 최신 변경 사항이 포함됩니다. 끄면 Yorozu는 다음 안정 버전을 기다립니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las versiones beta traen los cambios más recientes antes de una versión estable. Si lo desactivas, Yorozu espera a la siguiente versión estable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les versions bêta reçoivent les dernières nouveautés avant une version stable. Désactivé, Yorozu attend la prochaine version stable."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta-Versionen enthalten die neuesten Änderungen vor einer stabilen Version. Ausgeschaltet wartet Yorozu auf die nächste stabile Version."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As versões beta trazem as mudanças mais recentes antes de uma versão estável. Desativado, o Yorozu espera a próxima versão estável."
          }
        }
      }
    },
    "Updates" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
