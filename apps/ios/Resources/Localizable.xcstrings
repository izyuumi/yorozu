    "Speak a message instead of typing it. Speech is transcribed on this device; turning this on downloads the %@ model from Hugging Face." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージを入力する代わりに話せます。音声はこのデバイス上で文字起こしされます。オンにすると、%@のモデルを Hugging Face からダウンロードします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用说话代替打字来输入信息。语音在此设备上转写；打开后会从 Hugging Face 下载 %@ 的模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用說話代替打字來輸入訊息。語音在此裝置上轉寫；開啟後會從 Hugging Face 下載 %@ 的模型。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지를 입력하는 대신 말로 할 수 있습니다. 음성은 이 기기에서 받아쓰며, 켜면 Hugging Face에서 %@ 모델을 다운로드합니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicta un mensaje en lugar de escribirlo. La voz se transcribe en este dispositivo; al activarlo se descarga el modelo de %@ desde Hugging Face."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictez un message au lieu de le taper. La parole est transcrite sur cet appareil ; l’activer télécharge le modèle de %@ depuis Hugging Face."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich eine Nachricht, statt sie zu tippen. Die Sprache wird auf diesem Gerät transkribiert; beim Einschalten wird das Modell (%@) von Hugging Face geladen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale uma mensagem em vez de digitá-la. A fala é transcrita neste dispositivo; ao ativar, o modelo de %@ é baixado do Hugging Face."
          }
        }
      }
    },
    "This device needs more memory for voice input." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力には、このデバイスより多くのメモリが必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备的内存不足以使用语音输入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置的記憶體不足以使用語音輸入。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 입력을 사용하려면 이 기기보다 더 많은 메모리가 필요합니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo necesita más memoria para la entrada de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil n’a pas assez de mémoire pour la saisie vocale."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat zu wenig Arbeitsspeicher für die Spracheingabe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo precisa de mais memória para a entrada de voz."
          }
        }
      }
    },
