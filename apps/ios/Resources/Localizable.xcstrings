    "Tap the mic and talk. Stop to edit the text first, or send it right away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf das Mikrofon und sprich. Stoppe, um den Text erst zu bearbeiten, oder sende ihn sofort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el micrófono y habla. Detén para editar el texto antes o envíalo al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le micro et parlez. Arrêtez pour modifier le texte d’abord, ou envoyez-le tout de suite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクをタップして話します。停止すると文字を直してから送れます。すぐ送ることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크를 탭하고 말하세요. 멈추면 텍스트를 먼저 고칠 수 있고, 바로 보낼 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no microfone e fale. Pare para editar o texto antes ou envie na hora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点麦克风并说话。停止后可先编辑文字，也可以直接发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下麥克風並說話。停止後可先編輯文字，也可以直接傳送。"
          }
        }
      }
    },
