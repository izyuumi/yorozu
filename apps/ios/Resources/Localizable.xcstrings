    "Turn it on in Settings to speak messages. Speech is transcribed on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte sie in den Einstellungen ein, um Nachrichten zu sprechen. Die Sprache wird auf diesem Gerät transkribiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívala en Ajustes para dictar mensajes. La voz se transcribe en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez-la dans les réglages pour dicter vos messages. La transcription se fait sur cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定でオンにすると、話してメッセージを送れます。文字起こしはこのデバイス上で行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 켜면 말로 메시지를 보낼 수 있습니다. 음성은 이 기기에서 텍스트로 변환됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative em Ajustes para falar mensagens. A fala é transcrita neste dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设置中打开后即可说出消息。语音会在此设备上转写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在設定中開啟後即可說出訊息。語音會在此裝置上轉寫。"
          }
        }
      }
    },
