    "Set a field to Any to widen the rule. A field left at Any is not checked at all." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon un campo en «Cualquiera» para ampliar la regla. Los campos así definidos no se comprueban."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィールドを「任意」にするとルールの範囲が広がります。「任意」のフィールドは確認されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필드를 ‘모두’로 설정하면 규칙 범위가 넓어집니다. ‘모두’인 필드는 확인하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将字段设为“任意”可扩大规则范围。保持“任意”的字段不会被检查。"
          }
        }
      }
    },
