    "The host refused this pairing code. It may have expired or been used. Run `openclaw yorozu pair` again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストがこのペアリングコードを拒否しました。期限切れか使用済みの可能性があります。もう一度 `openclaw yorozu pair` を実行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
