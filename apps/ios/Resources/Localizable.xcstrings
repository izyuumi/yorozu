    "Update %@ cannot replace installed version %@. Older or invalid release versions are not installed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新 %@ はインストール済みのバージョン %@ を置き換えられません。古いバージョンや無効なリリースはインストールしません。"
          }
        }
      }
    },
    "Update automatically": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
