    "While Yorozu is open, replies in other conversations show at the top of the screen instead of as notifications." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu を開いている間、ほかの会話への返信は通知ではなく画面上部に表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu 打开时，其他对话中的回复会显示在屏幕顶部，而不是作为通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu 打開時，其他對話中的回覆會顯示在螢幕頂端，而不是作為通知。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorozu가 열려 있는 동안 다른 대화의 답장은 알림 대신 화면 상단에 표시됩니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras Yorozu está abierta, las respuestas de otras conversaciones aparecen en la parte superior de la pantalla en lugar de como notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque Yorozu est ouvert, les réponses dans d’autres conversations s’affichent en haut de l’écran au lieu de notifications."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange Yorozu geöffnet ist, erscheinen Antworten in anderen Unterhaltungen oben auf dem Bildschirm statt als Mitteilungen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o Yorozu aberto, respostas em outras conversas aparecem no topo da tela em vez de como notificações."
          }
        }
      }
    },
