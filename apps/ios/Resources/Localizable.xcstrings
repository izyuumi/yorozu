    "Speak a message instead of typing it. Speech is transcribed on this device by Apple Speech, which downloads each language the first time." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージを入力する代わりに話せます。音声はこのデバイス上で Apple Speech が書き起こし、各言語は初回にダウンロードされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用说话代替打字来发送消息。语音由 Apple Speech 在此设备上转写，每种语言会在首次使用时下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用說話代替打字來傳送訊息。語音由 Apple Speech 在此裝置上轉寫，每種語言會在首次使用時下載。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지를 입력하는 대신 말하세요. 음성은 이 기기에서 Apple Speech가 받아쓰며, 각 언어는 처음 사용할 때 다운로드됩니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di un mensaje en lugar de escribirlo. Apple Speech transcribe la voz en este dispositivo y descarga cada idioma la primera vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictez un message au lieu de le taper. Apple Speech transcrit la voix sur cet appareil et télécharge chaque langue la première fois."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich eine Nachricht, statt sie zu tippen. Apple Speech transkribiert auf diesem Gerät und lädt jede Sprache beim ersten Mal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale uma mensagem em vez de digitá-la. O Apple Speech transcreve a fala neste dispositivo e baixa cada idioma na primeira vez."
          }
        }
      }
    },
