      }
    },
    "Waiting for your approval" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esperando tu aprobación" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "承認を待っています" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "승인을 기다리는 중" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待你批准" } }
      }
    },
    "Waiting for your answer" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esperando tu respuesta" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "回答を待っています" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "답변을 기다리는 중" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待你回答" } }
      }
    },
    "Skip approvals for all agents" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Omitir aprobaciones para todos los agentes" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "すべてのエージェントの承認を省略" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "모든 에이전트의 승인 건너뛰기" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跳过所有智能体的批准请求" } }
      }
    },
    "Applies to all agents and conversations on the host Mac and its paired devices. Tool requests can run without asking, including purchases, messages, commands, and deletes." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se aplica a todos los agentes y conversaciones del Mac anfitrión y sus dispositivos emparejados. Las solicitudes de herramientas pueden ejecutarse sin pedir aprobación, incluidas compras, mensajes, comandos y eliminaciones." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストMac、およびそのMacにペアリング済みのデバイス上のすべてのエージェントと会話に適用されます。購入、メッセージ送信、コマンド実行、削除などのツール操作が、承認を求めずに実行されることがあります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 Mac 및 해당 Mac에 페어링된 기기의 모든 에이전트와 대화에 적용됩니다. 구매, 메시지 전송, 명령 실행, 삭제를 포함한 도구 요청이 승인 없이 실행될 수 있습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "适用于主机 Mac 及其已配对设备上的所有智能体和对话。工具请求可以不经批准就执行，包括购买、发送消息、运行命令和删除操作。" } }
      }
    },
    "Couldn’t connect. Generate a new pairing code and try again." : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo conectar. Genera un nuevo código de emparejamiento e inténtalo de nuevo." } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続できませんでした。新しいペアリングコードを生成して、もう一度お試しください。" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결할 수 없습니다. 새 페어링 코드를 생성한 후 다시 시도하세요." } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法连接。请生成新的配对码，然后重试。" } }
      }
    },
    "On your host Mac, open Yorozu, then choose Settings › Devices › Pair Another Device." : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "En el Mac anfitrión, abre Yorozu y elige Ajustes › Dispositivos › Emparejar otro dispositivo." } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストMacでYorozuを開き、「設定」›「デバイス」›「別のデバイスをペアリング」を選びます。" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 Mac에서 Yorozu를 열고 설정 › 기기 › 다른 기기 페어링을 선택하세요." } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在主机 Mac 上打开 Yorozu，然后选择“设置”›“设备”›“配对其他设备”。" } }
      }
    },
    "Scan pairing code" : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "Escanear código de emparejamiento" } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングコードをスキャン" } },
