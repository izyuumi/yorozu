    "It is deleted on the host and on every device, with its history." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会连同历史记录从主机和所有设备上删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它會連同歷史記錄從主機和所有裝置上刪除。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트와 모든 기기에서 기록과 함께 삭제됩니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elimina en el anfitrión y en todos los dispositivos, con su historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est supprimée de l’hôte et de tous les appareils, avec son historique."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wird samt Verlauf auf dem Host und auf allen Geräten gelöscht."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela é apagada no host e em todos os dispositivos, com o histórico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴とともに、ホストとすべてのデバイスから削除されます。"
          }
        }
      }
    },
    "It stops reaching the host and has to pair again." : {
      "localizations" : {
        "ja" : {
