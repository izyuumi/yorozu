    "Add an emoji to a message. The agent sees it on its next turn." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einer Nachricht ein Emoji hinzu. Der Agent sieht es bei seiner nächsten Antwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un emoji a un mensaje. El agente lo verá en su siguiente turno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un emoji à un message. L’agent le verra à son prochain tour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージに絵文字を付けられます。エージェントは次の返答のときに見ます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지에 이모지를 남기세요. 에이전트는 다음 차례에 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um emoji a uma mensagem. O agente vê na próxima vez que responder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给消息加上表情。智能体会在下一轮看到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為訊息加上表情符號。代理會在下一輪看到。"
          }
        }
      }
    },
    "Speak a message instead of typing it. Speech is transcribed on this device; turning this on downloads the %@ model from Apple." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージを入力する代わりに話せます。音声はこのデバイス上で文字起こしされます。オンにすると、%@のモデルを Apple からダウンロードします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用说话代替打字来输入信息。语音在此设备上转写；打开后会从 Apple 下载 %@ 的模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用說話代替打字來輸入訊息。語音在此裝置上轉寫；開啟後會從 Apple 下載 %@ 的模型。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지를 입력하는 대신 말로 할 수 있습니다. 음성은 이 기기에서 받아쓰며, 켜면 Apple에서 %@ 모델을 다운로드합니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicta un mensaje en lugar de escribirlo. La voz se transcribe en este dispositivo; al activarlo se descarga el modelo de %@ desde Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictez un message au lieu de le taper. La parole est transcrite sur cet appareil ; l’activer télécharge le modèle de %@ depuis Apple."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich eine Nachricht, statt sie zu tippen. Die Sprache wird auf diesem Gerät transkribiert; beim Einschalten wird das Modell (%@) von Apple geladen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale uma mensagem em vez de digitá-la. A fala é transcrita neste dispositivo; ao ativar, o modelo de %@ é baixado da Apple."
          }
        }
      }
    },
