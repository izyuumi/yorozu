    "Up to %@ more will be downloaded over cellular or a personal hotspot. Charges may apply." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu %@ werden noch über Mobilfunk oder einen persönlichen Hotspot geladen. Dabei können Kosten entstehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se descargarán hasta %@ más con datos móviles o un punto de acceso personal. Puede tener costes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à %@ supplémentaires seront téléchargés via le réseau cellulaire ou un partage de connexion. Des frais peuvent s’appliquer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残り最大%@をモバイルデータ通信またはインターネット共有でダウンロードします。通信料がかかる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 %@이(가) 셀룰러 또는 개인용 핫스팟으로 더 다운로드됩니다. 요금이 부과될 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até %@ a mais serão baixados por dados celulares ou acesso pessoal. Pode haver cobrança."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还将通过蜂窝网络或个人热点下载最多 %@，可能会产生费用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還會透過行動網路或個人熱點下載最多 %@，可能會產生費用。"
          }
        }
