    "To speak a message, allow Yorozu to use the microphone in Privacy & Security › Microphone." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージを話して入力するには、「プライバシーとセキュリティ」›「マイク」で Yorozu にマイクの使用を許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要用语音输入信息，请在“隐私与安全性” › “麦克风”中允许 Yorozu 使用麦克风。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要用語音輸入訊息，請在「隱私權與安全性」›「麥克風」中允許 Yorozu 使用麥克風。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말로 메시지를 입력하려면 개인정보 보호 및 보안 › 마이크에서 Yorozu의 마이크 사용을 허용하세요."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para dictar un mensaje, permite que Yorozu use el micrófono en Privacidad y seguridad › Micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour dicter un message, autorisez Yorozu à utiliser le micro dans Confidentialité et sécurité › Microphone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um eine Nachricht zu sprechen, erlaube Yorozu unter „Datenschutz & Sicherheit“ › „Mikrofon“ den Zugriff auf das Mikrofon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para falar uma mensagem, permita que o Yorozu use o microfone em Privacidade e Segurança › Microfone."
          }
        }
      }
    },
