    "Stops voice input and puts the transcript in the message field." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力を止めて、文字起こしをメッセージ欄に入れます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止语音输入，并把转写文字放入消息栏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止語音輸入，並把轉寫文字放入訊息欄。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 입력을 멈추고 받아쓴 텍스트를 메시지 입력란에 넣습니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detiene la entrada de voz y pone la transcripción en el campo de mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrête la saisie vocale et place la transcription dans le champ de message."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet die Spracheingabe und setzt das Transkript ins Nachrichtenfeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para a entrada de voz e coloca a transcrição no campo de mensagem."
          }
        }
      }
    },
