{
  "name": "yorozu-web",
  "account_id": "f4fc69dd41998fb00537d2f2fd08895d",
  "main": "./worker.mjs",
  "compatibility_date": "2026-03-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // The pages without a language prefix go through the worker, which picks the visitor's language.
    "run_worker_first": ["/", "/pair", "/pair/", "/add", "/add/", "/support", "/support/", "/privacy", "/privacy/",
      "/terms", "/terms/", "/mac", "/beta", "/beta/*"]
  },
  "routes": [{ "pattern": "yorozu.yumi.to", "custom_domain": true }]
}
