// yorozu.yumi.to: Astro static site plus retained beta candidate redirects. Pushes to main that
// touch apps/web deploy through .github/workflows/deploy-web.yml; to deploy by hand, run
//   pnpm --filter @yorozu/web run deploy
{
  "name": "yorozu-web",
  "account_id": "f4fc69dd41998fb00537d2f2fd08895d",
  "main": "./worker.mjs",
  "compatibility_date": "2026-03-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/mac", "/beta", "/beta/*"]
  },
  "routes": [{ "pattern": "yorozu.yumi.to", "custom_domain": true }]
}
