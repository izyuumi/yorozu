// yorozu.yumi.to: static site plus retained beta candidate redirects. Deploy from the repo root with
//   apps/relay/node_modules/.bin/wrangler deploy --config apps/web/wrangler.jsonc
{
  "name": "yorozu-web",
  "main": "./worker.mjs",
  "compatibility_date": "2026-03-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/mac", "/beta", "/beta/*"]
  },
  "routes": [{ "pattern": "yorozu.yumi.to", "custom_domain": true }]
}
