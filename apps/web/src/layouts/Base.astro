---
// Shared shell for every page. Styles and scripts stay external files in public/ so the
// `_headers` CSP can keep forbidding inline code.
interface Props {
  title: string;
  description: string;
  mainClass?: string;
}
const { title, description, mainClass } = Astro.props;
const path = Astro.url.pathname;
const home = path === '/';
const current = (href: string) => (href === path ? 'page' : undefined);
const pages = [['/', 'Home'], ['/privacy/', 'Privacy'], ['/terms/', 'Terms']];
---
<!DOCTYPE html>
<html lang={Astro.currentLocale ?? 'en'}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={new URL(path, Astro.site).href}>
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/secondary-preview.css">
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site">
    <a class="wordmark" href="/"><img src="/assets/icon.png" alt="" width="34" height="34">Yorozu</a>
    <nav aria-label="Primary">
      <a href="/privacy/" aria-current={current('/privacy/')}>Privacy</a>
      <a href="/terms/" aria-current={current('/terms/')}>Terms</a>
      <a href="https://github.com/izyuumi/yorozu">GitHub</a>
      {home && <a class="button small" href="/mac">Download for Mac</a>}
    </nav>
  </header>

  <main id="main" class={mainClass}>
    <slot />
  </main>

  <footer class="site">
    <span>© 2026 Yumi Izumi{home && '. Yorozu is not affiliated with OpenClaw, Anthropic or OpenAI.'}</span>
    <nav aria-label="Footer">
      {pages.filter(([href]) => href !== path).map(([href, label]) => <a href={href}>{label}</a>)}
      <a href="https://github.com/izyuumi/yorozu">GitHub</a>
    </nav>
  </footer>
</body>
</html>
