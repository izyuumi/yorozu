---
import Base from '../layouts/Base.astro';
import { agentPrompt, setupGuideUrl } from '../agent-prompt.mjs';
import { localePath } from '../i18n/locales.mjs';
import { localize, strings } from '../i18n/strings.mjs';

interface Props { locale: string }
const { locale } = Astro.props;
const h = strings[locale].home;
const html = (text: string) => localize(text, locale);
const docLinks = [
  setupGuideUrl,
  'https://github.com/izyuumi/yorozu/blob/main/docs/help-mcp.md',
  localePath(locale, '/support/'),
  'https://github.com/izyuumi/yorozu',
];
---
<Base locale={locale} page="/" title={h.title} description={h.description} og={h.og}>
  <section class="hero" aria-labelledby="title">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1 id="title" set:html={h.hero} />
        <p class="lede">{h.og.description}</p>
        <div class="actions">
          <a class="button" href="/iphone">{h.appStore}</a>
          <a class="button ghost" href="/mac">{h.downloadMac}</a>
        </div>
        <p class="fine" set:html={h.fine} />
      </div>
    </div>
  </section>

  <section class="agent-setup" id="agent" aria-labelledby="agent-title">
    <div class="agent-setup-text">
      <h2 id="agent-title">{h.agent.title}</h2>
      <p>{h.agent.intro}</p>
    </div>
    <div class="prompt">
      <pre><code id="agent-prompt">{agentPrompt(h.agent.language)}</code></pre>
      <button class="copy" type="button" data-copy="agent-prompt" data-copied={h.agent.copied} data-status={h.agent.status} data-failed={h.agent.failed} aria-label={h.agent.copyLabel} hidden>{h.agent.copy}</button>
    </div>
    <p class="copy-status" id="agent-prompt-status" role="status" aria-live="polite"></p>
    <p class="fine">{h.agent.note}</p>
  </section>

  <section class="steps" id="setup" aria-labelledby="setup-title">
    <h2 id="setup-title">{h.setupTitle}</h2>
    <p class="steps-intro" set:html={h.stepsIntro} />
    <ol>
      {h.steps.map(([title, text]: string[], index: number) => <li>
        <span class="num" aria-hidden="true">{index + 1}</span>
        <h3>{title}</h3>
        <p set:html={text} />
      </li>)}
    </ol>
  </section>

  <section class="docs" id="docs" aria-labelledby="docs-title">
    <h2 id="docs-title">{h.docsTitle}</h2>
    <ul class="doc-links">
      {h.docs.map(([label, text]: string[], index: number) => <li>
        <a href={docLinks[index]}>{label}</a>
        <p set:html={text} />
      </li>)}
    </ul>
  </section>

  <section class="warning" id="before-you-install" aria-labelledby="risk-title">
    <h2 id="risk-title">{h.riskTitle}</h2>
    {h.risk.map((text: string) => <p set:html={html(text)} />)}
  </section>
  <script is:inline src="/copy.js" defer></script>
</Base>
