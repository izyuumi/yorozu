<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- No sandbox: the agent drives the whole Mac, which is the point of the app. -->
  <!-- V8 compiles JavaScript to memory it then executes; the hardened runtime forbids
       that unless the binary says so. Both keys are what Node needs to start at all. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- The bundled Node links Homebrew's dylibs, signed by neither us nor Apple. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
