{
  "sourceLanguage": "en",
  "strings": {
    "NSAppleEventsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu drives Finder, Safari, Mail, Calendar, Messages and other apps on your behalf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼に応じてFinder、Safari、メール、カレンダー、メッセージなどのアプリを操作します。"
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu reads and writes your calendar when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼に応じてカレンダーを読み書きします。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu reads and writes your calendar when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼に応じてカレンダーを読み書きします。"
          }
        }
      }
    },
    "NSRemindersUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu reads and writes your reminders when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼に応じてリマインダーを読み書きします。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu reads and writes your reminders when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼に応じてリマインダーを読み書きします。"
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu looks up the people you write to, so you can say a name instead of an address."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが送信先の連絡先を検索し、アドレスの代わりに名前で指定できるようにします。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu finds and attaches pictures from your library when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼に応じてライブラリから写真を検索し、添付します。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu saves pictures to your library when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼に応じて写真をライブラリに保存します。"
          }
        }
      }
    },
    "NSAppleMusicUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu reads your music library so it can play what you ask for."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuがミュージックライブラリを読み取り、指定された曲を再生します。"
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu uses where you are to answer questions about travel time, weather and what is nearby."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが位置情報を使い、移動時間、天気、周辺情報についての質問に答えます。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu uses where you are to answer questions about travel time, weather and what is nearby."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが位置情報を使い、移動時間、天気、周辺情報についての質問に答えます。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu takes a picture only when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼された場合だけ写真を撮影します。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu listens only when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼された場合だけ音声を聞き取ります。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu turns what you dictate into the message you send."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが音声入力を、送信するメッセージの文章に変換します。"
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu reads and writes files on your Desktop when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼に応じてデスクトップのファイルを読み書きします。"
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu reads and writes files in your Documents folder when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼に応じて書類フォルダのファイルを読み書きします。"
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu reads and writes files in your Downloads folder when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼に応じてダウンロードフォルダのファイルを読み書きします。"
          }
        }
      }
    },
    "NSNetworkVolumesUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu reads and writes files on network volumes when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼に応じてネットワークボリュームのファイルを読み書きします。"
          }
        }
      }
    },
    "NSRemovableVolumesUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu reads and writes files on external drives when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼に応じて外部ドライブのファイルを読み書きします。"
          }
        }
      }
    },
    "NSFileProviderDomainUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu reads and writes files in iCloud Drive, Proton Drive and your other cloud drives when you ask it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuが依頼に応じてiCloud Drive、Proton Driveなどのクラウドドライブのファイルを読み書きします。"
          }
        }
      }
    },
    "NSSystemAdministrationUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu needs Full Disk Access to read and write files anywhere you can."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuがユーザーのアクセス可能な場所のファイルを読み書きするには、フルディスクアクセスが必要です。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
