        "ko" : { "stringUnit" : { "state" : "translated", "value" : "페어링된 기기 확인 중…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查已配对设备…" } }
      }
    },
    "Scan with Yorozu on your iPhone or iPad." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Escanea con Yorozu en tu iPhone o iPad." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneまたはiPadのYorozuでスキャンしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "iPhone 또는 iPad의 Yorozu로 스캔하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请使用 iPhone 或 iPad 上的 Yorozu 扫描。" } }
      }
    },
    "Pairing is temporarily unavailable" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El emparejamiento no está disponible temporalmente" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングを一時的に利用できません" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "일시적으로 페어링할 수 없습니다" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂时无法配对" } }
      }
    },
    "Check the connection in General settings. When Yorozu reconnects, request a new code." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Comprueba la conexión en los ajustes generales. Cuando Yorozu se reconecte, solicita un código nuevo." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「一般」設定で接続を確認してください。Yorozuが再接続したら、新しいコードを発行してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "일반 설정에서 연결을 확인하세요. Yorozu가 다시 연결되면 새 코드를 요청하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在“通用”设置中检查连接。Yorozu 重新连接后，请请求新的配对码。" } }
      }
    },
    "Preparing a pairing code…" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Preparando un código de emparejamiento…" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングコードを準備中…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "페어링 코드 준비 중…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在准备配对码…" } }
      }
    },
    "Use the pairing code below to connect your device." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Usa el código de emparejamiento de abajo para conectar tu dispositivo." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "下のペアリングコードを使ってデバイスを接続してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "아래 페어링 코드로 기기를 연결하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请使用下方配对码连接设备。" } }
      }
    },
    "Or paste this code into Yorozu on your iPhone, iPad, or another Mac." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "O pega este código en Yorozu en tu iPhone, iPad u otro Mac." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "または、このコードをiPhone、iPad、または別のMacのYorozuに貼り付けてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "또는 이 코드를 iPhone, iPad 또는 다른 Mac의 Yorozu에 붙여 넣으세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "或将此代码粘贴到 iPhone、iPad 或另一台 Mac 上的 Yorozu 中。" } }
      }
    },
    "Show full action" : {
