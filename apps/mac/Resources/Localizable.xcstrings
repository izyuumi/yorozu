        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@の値を入力するか、「任意」に切り替えてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@의 값을 입력하거나 모두로 전환하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请输入 %@ 的值，或切换为“任意”。" } }
      }
    },
    "Choose at least one scope field before saving." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige al menos un campo de alcance antes de guardar." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存する前に、適用範囲の項目を1つ以上選んでください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장하기 전에 적용 범위 필드를 하나 이상 선택하세요." } },
