    "Start one and it will be here, on this Mac and on your phone.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia uno y aparecerá aquí, en este Mac y en tu teléfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
