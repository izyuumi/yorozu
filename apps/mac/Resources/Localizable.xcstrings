    "A message can contain up to 10 attachments. Remove one to add another." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Un mensaje puede contener hasta 10 archivos adjuntos. Elimina uno para añadir otro." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "1つのメッセージに添付できるファイルは10個までです。別のファイルを追加するには、1つ取り除いてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "메시지 하나에 파일을 최대 10개까지 첨부할 수 있습니다. 다른 파일을 추가하려면 하나를 제거하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每条消息最多可包含 10 个附件。请移除一个后再添加其他附件。" } }
