    "Yorozu": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu"
          }
        }
      }
    },
    "Yorozu always asks about subscriptions, transfers, securities trades and crypto, whatever rules are saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu siempre pregunta sobre suscripciones, transferencias, operaciones con valores y criptomonedas, independientemente de las reglas guardadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたルールにかかわらず、サブスクリプション、送金、証券取引、暗号資産の取引については、Yorozuは常に確認を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu는 항상 청약, 양도, 증권 거래 및 암호화폐에 대해 어떤 규칙이 저장되어 있는지 묻습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论保存了何种规则，Yorozu 始终会针对订阅、转账、证券交易及加密货币操作进行确认。"
          }
        }
      }
    },
    "Yorozu always asks about this kind of action, whatever rules are saved.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu siempre pregunta por este tipo de acción, sin importar las reglas guardadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みルールにかかわらず、この種類の操作は常に確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 규칙과 관계없이 이런 종류의 작업은 항상 확인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论保存了什么规则，Yorozu 都会询问此类操作。"
          }
        }
      }
    },
    "Yorozu noticed you always allow this. Make it a rule?": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu ha visto que siempre permites esto. ¿Crear una regla?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつも許可している操作です。ルールにしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 허용하는 작업입니다. 규칙으로 만들까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu 注意到你总是允许此操作。要设为规则吗？"
          }
        }
      }
    },
    "Yorozu wants to": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu quiere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu が実行しようとしています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu가 다음 작업을 요청합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu 想要"
          }
        }
      }
    },
    "Yorozu will ask again before it does %arg.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu volverá a preguntar antes de realizar %arg."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%argを実行する前に、Yorozuは再度確認を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu는 %arg를 수행하기 전에 다시 물어볼 것입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu 将在执行 %arg 之前再次询问。"
          }
        }
      }
    },
    "Your Desktop, Documents, Downloads and cloud drives. macOS asks once per folder.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escritorio, documentos, descargas y unidades en la nube. macOS solicita permiso una vez por carpeta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップ、ドキュメント、ダウンロード、クラウドドライブ。macOSはフォルダごとに1回確認を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크탑, 문서, 다운로드 및 클라우드 드라이브. macOS는 폴더당 한 번씩 묻습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的“桌面”、“文稿”、“下载”文件夹及云端硬盘。macOS 会针对每个文件夹询问一次。"
          }
        }
      }
    },
    "Your iPhone is connected and ready to use.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu iPhone está conectado y listo para usar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneが接続され、使用可能な状態です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 연결되었으며 사용할 준비가 되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 iPhone 已连接并准备就绪。"
          }
        }
      }
    },
    "^[%arg approval](inflect: true) in the last month. Nothing is saved until you say so.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%arg aprobación](inflect: true) en el último mes. No se guarda nada hasta que tú lo indiques."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去1ヶ月間の ^[%arg approval] です。明示的に保存するまでは、何も保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 한 달간의 ^[%arg approval](inflect: true). 사용자가 저장하기 전까지는 아무것도 저장되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%arg approval](inflect: true)（过去一个月内）。除非您确认，否则不会保存任何内容。"
          }
        }
      }
    },
    "^[%arg item](inflect: true) in this batch": {
