      }
    },
    "Couldn’t open the selected files. Choose them again and check that they’re available on this device." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudieron abrir los archivos seleccionados. Selecciónalos de nuevo y comprueba que estén disponibles en este dispositivo." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択したファイルを開けませんでした。もう一度選択し、このデバイスで利用できることを確認してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "선택한 파일을 열 수 없습니다. 다시 선택하고 이 기기에서 사용할 수 있는지 확인하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法打开所选文件。请重新选择，并确认此设备可以访问这些文件。" } }
