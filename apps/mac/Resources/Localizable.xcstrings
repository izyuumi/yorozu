        "ko" : { "stringUnit" : { "state" : "translated", "value" : "페어링된 기기를 불러올 수 없습니다" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法加载已配对设备" } }
      }
    },
    "Check the connection in General settings, then try again." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Comprueba la conexión en los ajustes generales e inténtalo de nuevo." } },
