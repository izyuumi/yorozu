        "ko" : { "stringUnit" : { "state" : "translated", "value" : "첨부 파일을 불러올 수 없습니다. 다시 선택하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法加载附件。请重新选择。" } }
      }
    },
    "Couldn’t read: %@. Choose another file." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo leer: %@. Elige otro archivo." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み取れませんでした：%@。別のファイルを選んでください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "읽을 수 없습니다: %@. 다른 파일을 선택하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取：%@。请选择其他文件。" } }
      }
    },
    "Too large: %@. Each attachment must be 5 MB or smaller." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Demasiado grande: %@. Cada archivo adjunto debe ocupar 5 MB o menos." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "サイズが大きすぎます：%@。各添付ファイルは5 MB以下にしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "파일이 너무 큽니다: %@. 첨부 파일은 각각 5 MB 이하여야 합니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "文件过大：%@。每个附件不得超过 5 MB。" } }
      }
    },
    "A message can contain up to 10 attachments. Remove one to add another." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Un mensaje puede contener hasta 10 archivos adjuntos. Elimina uno para añadir otro." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "1つのメッセージに添付できるファイルは10個までです。別のファイルを追加するには、1つ取り除いてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "메시지 하나에 파일을 최대 10개까지 첨부할 수 있습니다. 다른 파일을 추가하려면 하나를 제거하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每条消息最多可包含 10 个附件。请移除一个后再添加其他附件。" } }
      }
    },
    "Send answer" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Enviar respuesta" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "回答を送信" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "답변 보내기" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "发送回答" } }
      }
    },
    "Enter a value for %@, or switch it to Any." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Introduce un valor para %@ o cambia a Cualquiera." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@の値を入力するか、「任意」に切り替えてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@의 값을 입력하거나 모두로 전환하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请输入 %@ 的值，或切换为“任意”。" } }
      }
    },
    "Choose at least one scope field before saving." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige al menos un campo de alcance antes de guardar." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存する前に、適用範囲の項目を1つ以上選んでください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장하기 전에 적용 범위 필드를 하나 이상 선택하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保存前请至少选择一个适用范围字段。" } }
      }
    },
    "Enter a valid amount of zero or more." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Introduce un importe válido igual o superior a cero." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "0以上の有効な金額を入力してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "0 이상의 올바른 금액을 입력하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请输入有效的非负金额。" } }
      }
    },
    "Wait for attachments to finish loading, then paste again." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Espera a que terminen de cargarse los archivos adjuntos e intenta pegar de nuevo." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "添付ファイルの読み込みが完了してから、もう一度貼り付けてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "첨부 파일을 모두 불러온 후 다시 붙여 넣으세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请等待附件加载完成，然后重新粘贴。" } }
