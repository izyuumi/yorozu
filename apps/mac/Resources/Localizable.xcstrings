    "Yorozu will remove pairing keys and all cached chats from this Mac.": {
      "localizations": {
        "es": { "stringUnit": { "state": "translated", "value": "Yorozu eliminará las claves de enlace y todos los chats almacenados en caché de este Mac." } },
