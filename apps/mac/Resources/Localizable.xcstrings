        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待运行时环境……"
          }
        }
      }
    },
    "Work with documents, downloads, cloud drives, and app data.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabaja con documentos, descargas, unidades en la nube y datos de aplicaciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドキュメント、ダウンロード、クラウドドライブ、アプリデータを扱います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서, 다운로드, 클라우드 드라이브, 앱 데이터로 작업하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理文档、下载内容、云端硬盘及应用数据。"
          }
