      }
    },
    "Remove paired device %@? Device ID: %@\n\nThis device will lose access to this Mac and must pair again to reconnect." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Eliminar el dispositivo emparejado %@? ID del dispositivo: %@\n\nEste dispositivo perderá el acceso a este Mac y deberá emparejarse de nuevo para reconectarse." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリング済みデバイス%@を削除しますか？ デバイスID：%@\n\nこのデバイスはこのMacにアクセスできなくなります。再接続するには、もう一度ペアリングする必要があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "페어링된 기기 %@을(를) 제거하시겠습니까? 기기 ID: %@\n\n이 기기는 이 Mac에 접근할 수 없게 됩니다. 다시 연결하려면 새로 페어링해야 합니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要移除已配对设备 %@ 吗？设备 ID：%@\n\n此设备将无法再访问这台 Mac，需要重新配对才能连接。" } }
      }
    },
    "No devices yet. Pair an iPhone, iPad, or another Mac to chat with this Mac." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Todavía no hay dispositivos. Empareja un iPhone, iPad u otro Mac para conversar con este Mac." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "デバイスはまだありません。iPhone、iPad、または別のMacをペアリングすると、このMacとチャットできます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "아직 기기가 없습니다. 이 Mac과 대화하려면 iPhone, iPad 또는 다른 Mac을 페어링하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "尚无设备。请配对 iPhone、iPad 或另一台 Mac，即可与这台 Mac 对话。" } }
      }
    },
    "Couldn’t load paired devices" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudieron cargar los dispositivos emparejados" } },
