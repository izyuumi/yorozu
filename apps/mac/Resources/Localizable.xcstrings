        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "币种" } }
      }
    },
    "Unspecified" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sin especificar" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "未指定" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지정되지 않음" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未指定" } }
      }
    },
    "Anything over the cap is asked about as usual. The cap uses the transaction’s currency." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Como siempre, se pedirá aprobación si se supera el límite. El límite usa la moneda de la transacción." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "上限を超える場合は、通常どおり承認を求めます。上限には取引の通貨を使用します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "한도를 초과하면 평소처럼 승인을 요청합니다. 한도는 거래 통화를 기준으로 합니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "超出上限时仍会照常请求批准。上限使用交易的币种。" } }
      }
    },
    "%@ (currency unspecified)" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "%@ (moneda sin especificar)" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@（通貨未指定）" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ (통화 미지정)" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@（币种未指定）" } }
      }
    },
    "Waiting for your approval" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esperando tu aprobación" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "承認を待っています" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "승인을 기다리는 중" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待你批准" } }
      }
    },
    "Waiting for your answer" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esperando tu respuesta" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "回答を待っています" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "답변을 기다리는 중" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待你回答" } }
      }
    },
    "Skip approvals for all agents" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Omitir aprobaciones para todos los agentes" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "すべてのエージェントの承認を省略" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "모든 에이전트의 승인 건너뛰기" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跳过所有智能体的批准请求" } }
      }
    },
    "Applies to all agents and conversations on the host Mac and its paired devices. Tool requests can run without asking, including purchases, messages, commands, and deletes." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se aplica a todos los agentes y conversaciones del Mac anfitrión y sus dispositivos emparejados. Las solicitudes de herramientas pueden ejecutarse sin pedir aprobación, incluidas compras, mensajes, comandos y eliminaciones." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストMac、およびそのMacにペアリング済みのデバイス上のすべてのエージェントと会話に適用されます。購入、メッセージ送信、コマンド実行、削除などのツール操作が、承認を求めずに実行されることがあります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 Mac 및 해당 Mac에 페어링된 기기의 모든 에이전트와 대화에 적용됩니다. 구매, 메시지 전송, 명령 실행, 삭제를 포함한 도구 요청이 승인 없이 실행될 수 있습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "适用于主机 Mac 及其已配对设备上的所有智能体和对话。工具请求可以不经批准就执行，包括购买、发送消息、运行命令和删除操作。" } }
      }
    },
    "Current model: %@" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Modelo actual: %@" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のモデル：%@" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 모델: %@" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前模型：%@" } }
      }
    },
    "Effort: %@" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esfuerzo: %@" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "思考量：%@" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "추론 강도: %@" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "推理强度：%@" } }
      }
    },
    "Host Mac offline" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Mac anfitrión sin conexión" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストMacはオフラインです" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 Mac이 오프라인 상태임" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "主机 Mac 已离线" } }
      }
    },
    "Offline" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sin conexión" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "オフライン" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "오프라인" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "离线" } }
      }
    },
    "Couldn’t connect" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo conectar" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続できませんでした" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결할 수 없습니다" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法连接" } }
      }
    },
    "Check your network and that Yorozu is open on your host Mac. Yorozu will keep trying to reconnect." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Comprueba tu conexión de red y que Yorozu esté abierto en el Mac anfitrión. Yorozu seguirá intentando reconectarse." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ネットワーク接続と、ホストMacでYorozuが起動していることを確認してください。Yorozuは再接続を試み続けます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "네트워크 연결을 확인하고 호스트 Mac에서 Yorozu가 실행 중인지 확인하세요. Yorozu가 계속 재연결을 시도합니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请检查网络连接，并确认主机 Mac 上已打开 Yorozu。Yorozu 会继续尝试重新连接。" } }
      }
    },
    "Open Yorozu on your host Mac. Your conversations will reconnect when it is available." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre Yorozu en el Mac anfitrión. Tus conversaciones se reconectarán cuando esté disponible." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストMacでYorozuを開いてください。接続できるようになると、会話は再接続されます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 Mac에서 Yorozu를 여세요. 연결이 가능해지면 대화가 다시 연결됩니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在主机 Mac 上打开 Yorozu。主机可用时，对话会重新连接。" } }
      }
    },
    "Connecting to your host Mac" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Conectando con tu Mac anfitrión" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストMacに接続中" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 Mac에 연결 중" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在连接主机 Mac" } }
      }
    },
    "Retry connection" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Reintentar conexión" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続を再試行" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결 다시 시도" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重试连接" } }
      }
    },
    "Retrying keeps your pairing and conversations." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Al reintentar se conservan el emparejamiento y las conversaciones." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "再試行しても、ペアリングと会話は保持されます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다시 시도해도 페어링과 대화는 유지됩니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重试会保留配对和对话。" } }
      }
    },
    "Couldn’t connect. Generate a new pairing code and try again." : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo conectar. Genera un nuevo código de emparejamiento e inténtalo de nuevo." } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続できませんでした。新しいペアリングコードを生成して、もう一度お試しください。" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결할 수 없습니다. 새 페어링 코드를 생성한 후 다시 시도하세요." } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法连接。请生成新的配对码，然后重试。" } }
      }
    },
    "How will this Mac use Yorozu?" : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Cómo usará Yorozu este Mac?" } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "このMacでYorozuをどのように使いますか？" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac에서 Yorozu를 어떻게 사용하시겠어요?" } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台 Mac 将如何使用 Yorozu？" } }
      }
    },
    "You can change this later in Settings." : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "Puedes cambiarlo más tarde en Ajustes." } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "後で設定から変更できます。" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "나중에 설정에서 변경할 수 있습니다." } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "稍后可在“设置”中更改。" } }
      }
    },
    "Host Yorozu on this Mac" : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "Alojar Yorozu en este Mac" } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "このMacでYorozuをホスト" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac에서 Yorozu 호스트" } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在这台 Mac 上托管 Yorozu" } }
      }
    },
    "Run OpenClaw here and let your iPhone or other Macs connect." : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "Ejecuta OpenClaw aquí y conecta tu iPhone u otros Mac." } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "ここでOpenClawを実行し、iPhoneやほかのMacから接続します。" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "여기서 OpenClaw를 실행하고 iPhone이나 다른 Mac을 연결하세요." } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在这里运行 OpenClaw，并让 iPhone 或其他 Mac 连接。" } }
      }
    },
    "Use Yorozu here while your host Mac does the work." : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "Usa Yorozu aquí mientras el Mac anfitrión hace el trabajo." } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストMacで処理しながら、このMacでYorozuを使います。" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 Mac에서 처리하고 이 Mac에서는 Yorozu를 사용하세요." } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "由主机 Mac 执行任务，在这台 Mac 上使用 Yorozu。" } }
      }
    },
    "Connect your devices" : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "Conecta tus dispositivos" } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "デバイスを接続" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "기기 연결" } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接设备" } }
      }
    },
    "Scan this code from Yorozu on an iPhone or client Mac." : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "Escanea este código desde Yorozu en un iPhone o Mac cliente." } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneまたはクライアントMacのYorozuでこのコードをスキャンします。" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "iPhone 또는 클라이언트 Mac의 Yorozu에서 이 코드를 스캔하세요." } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 iPhone 或客户端 Mac 上的 Yorozu 扫描此代码。" } }
      }
    },
    "Skip for now" : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "Omitir por ahora" } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "今はスキップ" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "나중에 하기" } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂时跳过" } }
      }
    },
    "Connect to your host Mac" : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "Conecta con tu Mac anfitrión" } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストMacに接続" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 Mac에 연결" } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接到主机 Mac" } }
      }
    },
    "On the host Mac, open Settings › Devices › Pair Another Device, then paste its code here." : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "En el Mac anfitrión, abre Ajustes › Dispositivos › Emparejar otro dispositivo y pega aquí el código." } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストMacで「設定」›「デバイス」›「別のデバイスをペアリング」を開き、コードをここに貼り付けます。" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 Mac에서 설정 › 기기 › 다른 기기 페어링을 열고 코드를 여기에 붙여 넣으세요." } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在主机 Mac 上打开“设置”›“设备”›“配对其他设备”，然后将代码粘贴到这里。" } }
      }
    },
    "That pairing code is invalid or expired." : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "El código de emparejamiento no es válido o ha caducado." } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングコードが無効か、有効期限が切れています。" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "페어링 코드가 잘못되었거나 만료되었습니다." } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该配对码无效或已过期。" } }
      }
    },
    "Choose what Yorozu can do" : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige qué puede hacer Yorozu" } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "Yorozuでできることを選ぶ" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "Yorozu가 할 수 있는 작업 선택" } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择 Yorozu 可以执行的操作" } }
      }
    },
    "Optional. Grant only capabilities you want; you can return anytime." : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "Opcional. Concede solo las funciones que quieras; puedes volver cuando quieras." } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "任意です。必要な機能だけを許可してください。いつでも変更できます。" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "선택 사항입니다. 원하는 기능만 허용하세요. 언제든 다시 설정할 수 있습니다." } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可选。只授予你需要的功能；随时可以回来更改。" } }
      }
    },
    "This Mac is ready to use Yorozu through your host Mac." : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "Este Mac ya puede usar Yorozu a través del Mac anfitrión." } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "このMacでホストMac経由のYorozuを使う準備ができました。" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac에서 호스트 Mac을 통해 Yorozu를 사용할 준비가 되었습니다." } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台 Mac 已可通过主机 Mac 使用 Yorozu。" } }
      }
    },
    "Your device is connected and ready to use." : {
      "localizations" : {
          "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu dispositivo está conectado y listo para usar." } },
          "ja" : { "stringUnit" : { "state" : "translated", "value" : "デバイスが接続され、使用できるようになりました。" } },
          "ko" : { "stringUnit" : { "state" : "translated", "value" : "기기가 연결되어 사용할 준비가 되었습니다." } },
          "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设备已连接，可以使用。" } }
      }
    },

