    "Waiting: earlier messages are still being handled" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待機中：前のメッセージをまだ処理しています"
          }
        }
      }
    },
    "%@ bytes. The limit is %@." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@バイト。上限は%2$@バイトです。"
          }
        }
      }
    },
    "%@ can’t take changes mid-run, so it gets this after its current run. Say stop to halt it now." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は実行中に変更を受け取れないため、今の実行の後に渡します。今すぐ止めるには「stop」と送ってください。"
          }
        }
      }
    },
    "%lld new" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新着%lld件"
          }
        }
      }
    },
    "%lld new messages, scroll to bottom" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新着メッセージ%lld件、最下部へスクロール"
          }
        }
      }
    },
    "%lld of %lld" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld / %2$lld"
          }
        }
      }
    },
    "(The full script is in jobs.toml.)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（スクリプト全体はjobs.tomlにあります。）"
          }
        }
      }
    },
    "A task failed" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タスクが失敗しました"
          }
        }
      }
    },
    "Added that to the task before it starts." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始前のタスクに追加しました。"
          }
