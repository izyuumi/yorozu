        "ko" : { "stringUnit" : { "state" : "translated", "value" : "일반 설정에서 연결을 확인한 후 다시 시도하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在“通用”设置中检查连接，然后重试。" } }
