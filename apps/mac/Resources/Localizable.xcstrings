        "ko" : { "stringUnit" : { "state" : "translated", "value" : "파일이 너무 큽니다: %@. 첨부 파일은 각각 5 MB 이하여야 합니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "文件过大：%@。每个附件不得超过 5 MB。" } }
