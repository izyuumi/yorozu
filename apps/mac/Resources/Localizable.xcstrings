    "Use only the services you want Yorozu to help with.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza solo los servicios en los que quieras que Yorozu te ayude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozuに任せたいサービスのみを利用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorozu가 도와주길 원하는 서비스만 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用您希望 Yorozu 协助处理的服务。"
          }
        }
      }
    },
    "Used only when a window exposes no accessibility tree, so the agent can fall back to a screenshot.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se utiliza solo cuando una ventana no expone un árbol de accesibilidad, para que el agente pueda recurrir a una captura de pantalla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウがアクセシビリティツリーを提示しない場合にのみ使用され、エージェントは代わりにスクリーンショットを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창에 접근성 트리가 표시되지 않는 경우에만 사용되므로 에이전트가 스크린샷으로 대체할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在窗口未提供辅助功能树（accessibility tree）时使用，以便代理程序改用屏幕截图。"
          }
        }
      }
    },
    "Waiting for the runtime…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando al entorno de ejecución..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランタイムを待機中…"
          }
