# Settings for the PAIOS scripts. `source` this file to export them. Keep your filled-in copy private.
# PAIOS_ROOT is the folder that contains PAIOS/. PAIOS_VAULT is its older name; keep both set to the same value.
export PAIOS_ROOT="/path/to/your folder"
export PAIOS_VAULT="$PAIOS_ROOT"
export PAIOS_TZ="UTC"
# export PAIOS_LOGS="$PAIOS_ROOT/PAIOS/Execution/Logs"
# export HANDOFF_ROOT="$PAIOS_ROOT/PAIOS/Handover"
# export HANDOFF_ROLES="chief-of-staff,coder,product-owner"
