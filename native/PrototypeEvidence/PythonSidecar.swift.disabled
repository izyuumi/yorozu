import SwiftUI
import AppKit

struct Message: Decodable, Identifiable { let id: String; let role: String; let body: String; let status: String?; let error: String? }
struct Topic: Decodable, Identifiable { let id: String; let label: String }
struct Job: Decodable, Identifiable { let id: String; let message: String; let status: String }
struct Snapshot: Decodable { let topics: [Topic]; let messages: [Message]; let tasks: [Job]; let subchats: [Subchat]? }
struct Subchat: Decodable, Identifiable { let id: String; let topic: String; let label: String; let status: String }
struct Event: Decodable, Identifiable { let ordinal: Int; let kind: String; let body: String; var id: Int { ordinal } }
struct Inspection: Decodable { let messages: [Message]; let events: [Event] }

@MainActor final class Model: ObservableObject {
    @Published var state: Snapshot?; @Published var inspection: Inspection?
    @Published var selected: String?; @Published var draft = ""; @Published var notice = "Starting offline backend…"
    @Published var sending = false
    private var process: Process?; private var base: URL?; private var timer: Timer?
    func start() {
        guard process == nil, let resources = Bundle.main.resourceURL else { return }
        let p = Process(); let pipe = Pipe()
        p.executableURL = URL(fileURLWithPath: "/usr/bin/python3")
        p.arguments = [resources.appendingPathComponent("backend/server.py").path]
        p.currentDirectoryURL = resources.appendingPathComponent("backend")
        var env = ProcessInfo.processInfo.environment // Attribution markers are deliberately preserved.
        env["PROJECTX_LIVE"] = "0" // This bounded native POC cannot launch live Gateway calls.
        env["PROJECTX_PORT"] = "0"
        env["PROJECTX_DATA"] = env["PROJECTX_NATIVE_DATA"] ?? resources.appendingPathComponent("../../../data").standardizedFileURL.path
        env["PYTHONDONTWRITEBYTECODE"] = "1"
        p.environment = env; p.standardOutput = pipe; p.standardError = FileHandle.nullDevice
        pipe.fileHandleForReading.readabilityHandler = { handle in
            let data = handle.availableData
            guard let line = String(data: data, encoding: .utf8), let range = line.range(of: "http://127.0.0.1:") else { return }
            let address = line[range.lowerBound...].prefix { !$0.isWhitespace }
            Task { @MainActor in self.base = URL(string: String(address)); self.notice = "Offline POC · live integration not verified"; await self.refresh() }
        }
        do { try p.run(); process = p } catch { notice = "Backend could not start: \(error.localizedDescription)" }
        timer = Timer.scheduledTimer(withTimeInterval: 1, repeats: true) { _ in Task { @MainActor in await self.refresh() } }
    }
    func stop() { timer?.invalidate(); timer = nil; if process?.isRunning == true { process?.terminate() }; process = nil }
    func fetch<T: Decodable>(_ path: String, as type: T.Type) async throws -> T {
        guard let base else { throw URLError(.cannotConnectToHost) }
        let (data, response) = try await URLSession.shared.data(from: base.appendingPathComponent(path))
        guard (response as? HTTPURLResponse)?.statusCode == 200 else { throw URLError(.badServerResponse) }
        return try JSONDecoder().decode(type, from: data)
    }
    func refresh() async {
        guard base != nil else { return }
        do { state = try await fetch("api/state", as: Snapshot.self)
            if let selected { inspection = try await fetch("api/subchat/" + selected, as: Inspection.self) }
        } catch { notice = "Backend disconnected. No automatic task replay." }
    }
    func send() async {
        guard let base, !sending, !draft.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else { return }
        let text = draft; sending = true; defer { sending = false }
        var request = URLRequest(url: base.appendingPathComponent("api/send")); request.httpMethod = "POST"
        request.setValue("application/json", forHTTPHeaderField: "Content-Type"); request.setValue("1", forHTTPHeaderField: "X-ProjectX")
        request.setValue(base.absoluteString, forHTTPHeaderField: "Origin")
        request.httpBody = try? JSONSerialization.data(withJSONObject: ["body": text])
        do { let (_, response) = try await URLSession.shared.data(for: request)
            guard (response as? HTTPURLResponse)?.statusCode == 200 else { notice = "Message not accepted. Check size (6000 UTF-8 bytes maximum)."; return }
            if draft == text { draft = "" }; await refresh()
        } catch { notice = "Send outcome uncertain. Inspect history before resending." }
    }
}
struct Transcript: View {
    let messages: [Message]
    var body: some View {
        ScrollView { LazyVStack(alignment: .leading, spacing: 16) {
            ForEach(messages) { message in VStack(alignment: .leading, spacing: 5) {
                Text(message.role == "user" ? "You" : "PROJECTX").font(.caption).foregroundStyle(.secondary)
                Text(message.body).textSelection(.enabled).frame(maxWidth: .infinity, alignment: .leading)
                if message.status == "pending" { Text("Received · working in sub-chat").font(.caption).foregroundStyle(.secondary) }
                if let error = message.error { Text(error).font(.caption).foregroundStyle(.orange).textSelection(.enabled) }
            }.padding(12).background(message.role == "user" ? Color.accentColor.opacity(0.08) : Color.secondary.opacity(0.05)).cornerRadius(10) }
        }.padding() }
    }
}
struct ContentView: View {
    @ObservedObject var model: Model
    @State private var sidebar = true
    var body: some View {
        VStack(spacing: 0) {
            HStack { Button { sidebar.toggle() } label: { Image(systemName: "sidebar.left") }.help("Toggle sub-chats")
                Text("PROJECTX").font(.headline); Spacer(); Text(model.notice).font(.caption).foregroundStyle(.secondary)
            }.padding(12)
            Divider()
            HSplitView {
                if sidebar { VStack(alignment: .leading) { Text("Sub-chats").font(.headline).padding()
                    List(model.state?.subchats ?? []) { chat in Button { model.selected = chat.id; model.inspection = nil; Task { await model.refresh() } } label: {
                        HStack { Image(systemName: ["working", "queued", "amendment_pending"].contains(chat.status) ? "circle.dotted" : chat.status == "done" ? "checkmark.circle" : "circle"); Text(chat.label); Spacer() }.contentShape(Rectangle())
                    }.buttonStyle(.plain).help(chat.status) }
                }.frame(minWidth: 160, idealWidth: 200, maxWidth: 280) }
                VStack(spacing: 0) {
                    Transcript(messages: model.state?.messages ?? [])
                    Divider()
                    HStack(alignment: .bottom) { TextEditor(text: $model.draft).font(.body).frame(minHeight: 54, maxHeight: 100).accessibilityLabel("Main conversation message")
                        Button("Send") { Task { await model.send() } }.keyboardShortcut(.return, modifiers: .command).disabled(model.sending || model.draft.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty)
                    }.padding()
                }.frame(minWidth: 380)
                if let selected = model.selected {
                    VStack(alignment: .leading) {
                        HStack { Text(model.state?.subchats?.first { $0.id == selected }?.label ?? "Sub-chat").font(.headline); Spacer(); Button { model.selected = nil; model.inspection = nil } label: { Image(systemName: "xmark") } }.padding()
                        Text("Inspect only").font(.caption).foregroundStyle(.secondary).padding(.horizontal)
                        Transcript(messages: model.inspection?.messages ?? [])
                        ScrollView { LazyVStack(alignment: .leading) { ForEach(model.inspection?.events ?? []) { event in VStack(alignment: .leading) { Text(event.kind).font(.caption).foregroundStyle(.secondary); Text(event.body).textSelection(.enabled) }.padding(8) } } }
                    }.frame(minWidth: 260, idealWidth: 330, maxWidth: 500)
                }
            }
        }.frame(minWidth: 780, minHeight: 500).onAppear { model.start() }
    }
}
final class Delegate: NSObject, NSApplicationDelegate {
    var model: Model?
    func applicationWillTerminate(_ notification: Notification) { MainActor.assumeIsolated { model?.stop() } }
    func applicationShouldTerminateAfterLastWindowClosed(_ sender: NSApplication) -> Bool { true }
}
@main struct ProjectXApp: App {
    @NSApplicationDelegateAdaptor(Delegate.self) var delegate
    @StateObject private var model = Model()
    var body: some Scene { WindowGroup { ContentView(model: model).onAppear { delegate.model = model } }.defaultSize(width: 1180, height: 760) }
}
