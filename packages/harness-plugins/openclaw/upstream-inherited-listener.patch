+import {expect,it} from 'vitest';
+import {createDirectChatContext} from './src/gateway/server-chat.agent-events.test-helpers.js';
+import {pendingChatSendDedupeKey} from './src/gateway/server-shared.js';
+import {writePreRegisteredChatAbort} from './src/gateway/server-methods/chat-abort-authorization.js';
+import {normalizeChatSendRequest} from './src/gateway/server-methods/chat-send-request.js';
+import {resolveChatSendRequestConflict} from './src/gateway/server-methods/chat-send-pre-admission.js';
+it('does not reinterpret early-aborted literal operation as stop after identity cache expiry',()=>{
+ const context=createDirectChatContext();
+ const params={sessionKey:'agent:main:review',message:'/stop',idempotencyKey:'early-abort'};
+ const literal=normalizeChatSendRequest({client:null,params:{...params,inputMode:'literal'}});
+ const normal=normalizeChatSendRequest({client:null,params});
+ if(!literal.ok||!normal.ok) throw new Error('normalization failed');
+ const pending=pendingChatSendDedupeKey('early-abort');
+ context.dedupe.set(pending,{ts:1,ok:true,requestIdentity:literal.value.requestIdentity,inputParsingMode:'literal-v1',payload:{runId:'early-abort',status:'accepted',sessionKey:params.sessionKey,attemptId:'attempt'}});
+ writePreRegisteredChatAbort({context,runId:'early-abort',stopReason:'rpc',attemptId:'attempt',endedAt:2});
+ console.log('terminal mode retained:',context.dedupe.get('chat:early-abort')?.inputParsingMode);
+ context.dedupe.delete('chat:early-abort');
+ expect(context.chatRunState.hasAbortMarker('early-abort')).toBe(true);
+ const error=resolveChatSendRequestConflict({request:normal.value,context,session:{clientRunId:'early-abort',pendingChatSendKey:pending,entry:{sessionId:'review',updatedAt:1},agentId:'main',sessionKey:params.sessionKey,storePath:'/unused-review-abort',restartSafeRequest:undefined}});
+ expect(error).toMatchObject({details:{reason:'chat-request-conflict'}});
+});
