+  const cfg = getRuntimeConfig();
+  setRuntimeConfigSnapshot({ ...cfg, session: { ...cfg.session, store: input.scope.storePath } });
+  expect(readChatInputAdmission(input.scope, input.params.idempotencyKey)).toMatchObject({
+    abortedAt: expect.any(Number),
+  });
+  const context = createDirectChatContext({ getRuntimeConfig, chatQueuedTurns: new Map() });
+  const active = createActiveRun(input.scope.sessionKey, {
+    sessionId: input.scope.sessionId,
+    agentId: "main",
+    owner: { connId: input.client.connId },
+  });
+  context.chatAbortControllers.set("unrelated-active", active);
+  const send = async () => {
+    const respond = vi.fn();
+    await handleChatSend({
+      params: input.params,
+      req: { type: "req", id: "restart", method: "chat.send", params: input.params },
+      client: input.client,
+      context,
+      respond,
+      isWebchatConnect: () => true,
+    });
+    return respond;
+  };
+  expect(await send()).toHaveBeenCalledWith(
+    true,
+    expect.objectContaining({ status: "timeout", summary: "aborted" }),
+    undefined,
+    expect.anything(),
+  );
+  if (input.params.inputMode === "literal") delete input.params.inputMode;
+  else input.params.inputMode = "literal";
+  expect(await send()).toHaveBeenCalledWith(
+    false,
+    undefined,
+    expect.objectContaining({ details: { reason: "chat-request-conflict" } }),
+  );
+  delete input.params.inputMode;
+  input.params.message = "/stop";
+  expect(await send()).toHaveBeenCalledWith(
+    false,
+    undefined,
+    expect.objectContaining({ details: { reason: "chat-request-conflict" } }),
+  );
