@@ -0,0 +1,123 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { readSessionSubmittedInput } from "../../config/sessions/session-accessor.js";
+import { buildPersistedUserTurnMessage } from "../../sessions/user-turn-transcript.message.js";
+import {
+  preparePersistedUserTurnMessageForTranscriptWrite,
+  restorePreparedUserTurnOperationalMetaForRuntime,
+} from "../../sessions/user-turn-transcript.metadata.js";
+import { createDirectChatContext } from "../server-chat.agent-events.test-helpers.js";
+import { pendingChatSendDedupeKey } from "../server-shared.js";
+import { resolveChatSendRequestConflict, respondChatSendRetry } from "./chat-send-pre-admission.js";
+import { normalizeChatSendRequest } from "./chat-send-request.js";
+vi.mock("../../config/sessions/session-accessor.js", async (original) => ({
+  ...(await original<typeof import("../../config/sessions/session-accessor.js")>()),
+  readSessionSubmittedInput: vi.fn(),
+}));
+beforeEach(() => vi.mocked(readSessionSubmittedInput).mockReset());
+function fixture(literal: boolean) {
+  const normalized = normalizeChatSendRequest({
+    client: null,
+    params: {
+      sessionKey: "agent:main:literal",
+      message: "/stop",
+      idempotencyKey: "durable",
+      ...(literal ? { inputMode: "literal" } : {}),
+    },
+  });
+  if (!normalized.ok) throw new Error(normalized.error);
+  return {
+    request: normalized.value,
+    context: createDirectChatContext(),
+    respond: vi.fn(),
+    session: {
+      clientRunId: "durable",
+      pendingChatSendKey: pendingChatSendDedupeKey("durable"),
+      entry: { sessionId: "literal", updatedAt: 1 },
+      agentId: "main",
+      sessionKey: "agent:main:literal",
+      storePath: "/unused",
+      restartSafeRequest: undefined,
+    },
+  };
+}
+function source(literal: boolean) {
+  const { request } = fixture(literal);
+  return buildPersistedUserTurnMessage({
+    text: request.rawMessage,
+    idempotencyKey: "durable:user",
+    timestamp: 1,
+    commandInterpretation: literal ? "literal-v1" : "normal-v1",
+    chatRequestIdentity: request.requestIdentity,
+  });
+}
+describe("versioned parsing custody", () => {
+  it("checks retained terminal parsing attestation even when raw identity matches", () => {
+    const f = fixture(false);
+    f.context.dedupe.set("chat:durable", {
+      ts: 1,
+      ok: true,
+      requestIdentity: f.request.requestIdentity,
+      inputParsingMode: "literal-v1",
+      payload: { status: "ok" },
+    });
+    expect(resolveChatSendRequestConflict(f)).toBeDefined();
+  });
+  it.each([true, false])(
+    "denies symmetric mode changes without any RAM/terminal entry: original literal=%s",
+    (literal) => {
+      vi.mocked(readSessionSubmittedInput).mockReturnValue(source(literal));
+      expect(resolveChatSendRequestConflict(fixture(!literal))).toMatchObject({
+        details: { reason: "chat-request-conflict" },
+      });
+      expect(resolveChatSendRequestConflict(fixture(literal))).toBeUndefined();
+    },
+  );
+  it.each([true, false])("denies missing/invalid required identity, mode=%s", (literal) => {
+    const message = source(literal);
+    delete message.__openclaw!.chatRequestIdentity;
+    vi.mocked(readSessionSubmittedInput).mockReturnValue(message);
+    expect(resolveChatSendRequestConflict(fixture(literal))).toBeDefined();
+    message.__openclaw!.commandInterpretation = "literal-v2";
+    expect(resolveChatSendRequestConflict(fixture(literal))).toBeDefined();
+  });
+  it("preserves legacy normal sources, never reinterprets them as literal", () => {
+    const legacy = buildPersistedUserTurnMessage({
+      text: "/stop",
+      idempotencyKey: "durable:user",
+      timestamp: 1,
+    });
+    vi.mocked(readSessionSubmittedInput).mockReturnValue(legacy);
+    expect(resolveChatSendRequestConflict(fixture(false))).toBeUndefined();
+    expect(resolveChatSendRequestConflict(fixture(true))).toBeDefined();
+  });
+  it("does not globally reject legacy terminal retries with no submitted source", () => {
+    const f = fixture(false);
+    f.context.dedupe.set("chat:durable", { ts: 1, ok: true, payload: { status: "ok" } });
+    expect(respondChatSendRetry(f)).toBe(true);
+    expect(f.respond).toHaveBeenCalledWith(true, { status: "ok" }, undefined, { cached: true });
+  });
+  it.each([true, false])(
+    "restores reserved parsing evidence after hooks, literal=%s",
+    (literal) => {
+      const original = source(literal);
+      const expected = structuredClone(original.__openclaw);
+      const prepared = preparePersistedUserTurnMessageForTranscriptWrite(original, {
+        beforeMessageWrite: ({ message }) => {
+          message.__openclaw = { commandInterpretation: "forged", chatRequestIdentity: "forged" };
+          return message;
+        },
+      });
+      expect(prepared?.__openclaw).toEqual(expected);
+      const runtime = restorePreparedUserTurnOperationalMetaForRuntime({
+        preparedMessage: prepared,
+        runtimeMessage: {
+          role: "user",
+          content: "changed",
+          timestamp: 2,
+          __openclaw: { commandInterpretation: "forged" },
+        },
+      });
+      expect(runtime.__openclaw).toEqual(expected);
+    },
+  );
+});
