+import { bindChatInputParsingHash, readChatInputParsingHash } from "./chat-input-parsing.js";
+it("keeps consumed pre-extension normal receipts without upgrading or accepting changed/literal input", () => {
+  const old = { role: "user" as const, content: "hello", idempotencyKey: "old:user" };
+  const receipt = {
+    request_hash: createHash("sha256").update(stableStringify(old)).digest("hex"),
+    consumed_event_id: "old-event",
+  };
+  for (const mode of ["normal-v1", "literal-v1"] as const) {
+    const message = {
+      ...old,
+      timestamp: 1,
+      __openclaw: { commandInterpretation: mode, chatRequestIdentity: "a".repeat(64) },
+    };
+    const prepared = preparePendingInputRequest({ runId: "old", message });
+    expect(
+      matchesSessionPendingInputRequest(receipt, prepared.stableMessage, prepared.requestHash),
+    ).toBe(mode === "normal-v1");
+    expect(
+      matchesSessionPendingInputRequest(
+        receipt,
+        { ...prepared.stableMessage, content: "changed" },
+        prepared.requestHash,
+      ),
+    ).toBe(false);
+  }
+});
+it("rejects malformed or future versions and cannot synthesize missing evidence", () => {
+  expect(readChatInputParsingHash("chat-parsing-v2:literal-v1:unknown")).toBe("invalid");
+  expect(() => bindChatInputParsingHash("hash", { commandInterpretation: "literal-v1" })).toThrow(
+    "incomplete",
+  );
+  expect(readChatInputParsingHash("request:legacy")).toBeUndefined();
+});
diff --git a/src/sessions/chat-input-parsing.ts b/src/sessions/chat-input-parsing.ts
new file mode 100644
index 00000000..7326db5b
--- /dev/null
+++ b/src/sessions/chat-input-parsing.ts
@@ -0,0 +1,36 @@
+/** Parsing attenuation evidence, not input provenance or caller authority. */
+export type ChatInputParsingMode = "normal-v1" | "literal-v1" | "suppressed-v1";
+export type ChatInputParsingEvidence = { mode: ChatInputParsingMode; identity: string };
+const PREFIX = "chat-parsing-v1:";
+export function readChatInputParsingHash(
+  hash: string,
+): ChatInputParsingEvidence | "invalid" | undefined {
+  if (!hash.startsWith("chat-parsing-")) return undefined;
+  const match = /^chat-parsing-v1:(normal-v1|literal-v1|suppressed-v1):([a-f0-9]{64}):(.+)$/u.exec(
+    hash,
+  );
+  return match ? { mode: match[1] as ChatInputParsingMode, identity: match[2]! } : "invalid";
+}
+export function bindChatInputParsingHash(
+  hash: string,
+  metadata: Record<string, unknown> | undefined,
+): string {
+  if (metadata?.commandInterpretation === undefined && metadata?.chatRequestIdentity === undefined)
+    return hash;
+  const mode = metadata?.commandInterpretation;
+  const identity = metadata?.chatRequestIdentity;
+  if (
+    (mode !== "normal-v1" && mode !== "literal-v1" && mode !== "suppressed-v1") ||
+    typeof identity !== "string" ||
+    !/^[a-f0-9]{64}$/u.test(identity)
+  ) {
+    throw new Error("Chat parsing evidence is incomplete");
+  }
+  return `${PREFIX}${mode}:${identity}:${hash}`;
+}
+/** Only pre-extension NORMAL sources can use their unversioned request digest. */
+export function legacyNormalChatInputHash(hash: string): string | undefined {
+  return readChatInputParsingHash(hash) !== "invalid" && hash.startsWith(`${PREFIX}normal-v1:`)
+    ? hash.slice(`${PREFIX}normal-v1:`.length + 65)
+    : undefined;
+}
