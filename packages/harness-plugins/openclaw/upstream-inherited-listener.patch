+// REQUIRED SECURITY ACCEPTANCE: originally red on the normalization-only prototype.
+// Keep this fail-closed assertion uninverted and unskipped.
+import { expect, it, vi } from "vitest";
+import { createDirectChatContext } from "../server-chat.agent-events.test-helpers.js";
+import { pendingChatSendDedupeKey } from "../server-shared.js";
+import { resolveChatSendRequestConflict } from "./chat-send-pre-admission.js";
+import { normalizeChatSendRequest } from "./chat-send-request.js";
+vi.mock("../../config/sessions/session-accessor.js", async (original) => ({
+  ...(await original<typeof import("../../config/sessions/session-accessor.js")>()),
+  readSessionSubmittedInput: vi.fn(() => undefined),
+}));
+it("fails closed for literal retry when terminal evidence outlives the parsing-mode fingerprint", () => {
+  const normalized = normalizeChatSendRequest({
+    client: null,
+    params: {
+      sessionKey: "agent:main:literal-review",
+      message: "/stop",
+      inputMode: "literal",
+      idempotencyKey: "mode-retired",
+    },
+  });
+  if (!normalized.ok) throw new Error(normalized.error);
+  const context = createDirectChatContext();
+  context.dedupe.set("chat:mode-retired", {
+    ts: 1,
+    ok: true,
+    payload: { runId: "mode-retired", status: "ok" },
+  });
+  const error = resolveChatSendRequestConflict({
+    request: normalized.value,
+    context,
+    session: {
+      clientRunId: "mode-retired",
+      pendingChatSendKey: pendingChatSendDedupeKey("mode-retired"),
+      entry: { sessionId: "literal-review", updatedAt: 1 },
+      agentId: "main",
+      sessionKey: "agent:main:literal-review",
+      storePath: "/unused-review-fixture",
+      restartSafeRequest: undefined,
+    },
+  });
+  expect(error).toMatchObject({ details: { reason: "chat-request-conflict" } });
+});
diff --git a/src/gateway/server-methods/chat-send-literal-early-abort-storage.test.ts b/src/gateway/server-methods/chat-send-literal-early-abort-storage.test.ts
