+// Fresh process reads only task-owned SQLite custody. No Gateway or provider is started.
+import {
+  readSessionInputParsingEvidence,
+  stageSessionPendingInput,
+} from "../../src/config/sessions/session-accessor.js";
+import { closeOpenClawAgentDatabasesAsync } from "../../src/state/openclaw-agent-db-lifecycle.js";
+const input = JSON.parse(process.argv[2]!);
+const evidence = readSessionInputParsingEvidence(input.scope, input.message.idempotencyKey);
+const replay = await stageSessionPendingInput(input.scope, {
+  runId: "once",
+  message: input.message,
+  assertCurrent: () => {},
+});
+if (replay?.state !== "consumed") throw new Error("Fresh process would redispatch accepted input");
+console.log(JSON.stringify({ evidence, state: replay.state }));
+replay.finish("interrupted");
+await closeOpenClawAgentDatabasesAsync();
