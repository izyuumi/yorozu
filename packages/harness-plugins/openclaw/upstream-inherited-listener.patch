@@ -0,0 +1,173 @@
+import type { DatabaseSync } from "node:sqlite";
+import {
+  executeSqliteQuerySync,
+  executeSqliteQueryTakeFirstSync,
+  getNodeSqliteKysely,
+} from "../../infra/kysely-sync.js";
+import type { ChatInputParsingMode } from "../../sessions/chat-input-parsing.js";
+import { withOpenClawAgentDatabaseReadOnly } from "../../state/openclaw-agent-db-readonly.js";
+import { runOpenClawAgentWriteTransaction } from "../../state/openclaw-agent-db.js";
+import type { SessionAccessScope } from "./session-accessor.sqlite-contract.js";
+import { readSessionEntryRow } from "./session-accessor.sqlite-entry-store.js";
+import { resolveSqliteScope, toDatabaseOptions } from "./session-accessor.sqlite-scope.js";
+
+type AdmissionRow = {
+  session_key: string;
+  run_id: string;
+  session_id: string | null;
+  request_identity: string;
+  parsing_mode: string;
+  attempt_id: string;
+  aborted_at: number | null;
+  stop_reason: string | null;
+};
+type AdmissionScope = SessionAccessScope & { agentId: string; sessionId?: string };
+const table = "session_chat_input_admissions";
+const query = (db: DatabaseSync) =>
+  getNodeSqliteKysely<{ session_chat_input_admissions: AdmissionRow }>(db);
+function hasTable(db: DatabaseSync) {
+  // sqlite-allow-raw -- Read-only feature schema discovery, no application data.
+  return Boolean(
+    db.prepare("SELECT 1 FROM sqlite_schema WHERE type = 'table' AND name = ?").get(table),
+  );
+}
+function ensureTable(db: DatabaseSync) {
+  // sqlite-allow-raw -- Additive feature-owned DDL; rows use typed Kysely.
+  db.exec(`CREATE TABLE IF NOT EXISTS session_chat_input_admissions (
+    session_key TEXT NOT NULL, run_id TEXT NOT NULL, session_id TEXT,
+    request_identity TEXT NOT NULL, parsing_mode TEXT NOT NULL, attempt_id TEXT NOT NULL,
+    aborted_at INTEGER, stop_reason TEXT,
+    PRIMARY KEY (session_key, run_id)
+  )`);
+}
+function read(db: DatabaseSync, sessionKey: string, runId: string) {
+  return executeSqliteQueryTakeFirstSync(
+    db,
+    query(db)
+      .selectFrom(table)
+      .selectAll()
+      .where("session_key", "=", sessionKey)
+      .where("run_id", "=", runId),
+  );
+}
+function valid(row: AdmissionRow) {
+  return (
+    /^[a-f0-9]{64}$/u.test(row.request_identity) &&
+    ["literal-v1", "normal-v1", "suppressed-v1"].includes(row.parsing_mode) &&
+    Boolean(row.attempt_id) &&
+    (row.aborted_at === null || Number.isFinite(row.aborted_at))
+  );
+}
+
+/** Admission custody precedes the first await and survives response-cache retirement.
+ * It attenuates retries only; it is never execution or abort authorization.
+ * Missing pre-extension tables are read without migrating them.
+ */
+export function readChatInputAdmission(scope: AdmissionScope, runId: string) {
+  try {
+    const resolved = resolveSqliteScope(scope);
+    const result = withOpenClawAgentDatabaseReadOnly(({ db }) => {
+      if (!hasTable(db)) return undefined;
+      const row = read(db, resolved.sessionKey, runId);
+      if (!row) return undefined;
+      if (!valid(row) || (row.session_id !== null && row.session_id !== scope.sessionId))
+        return "invalid" as const;
+      return {
+        identity: row.request_identity,
+        mode: row.parsing_mode as ChatInputParsingMode,
+        abortedAt: row.aborted_at,
+        stopReason: row.stop_reason,
+      };
+    }, toDatabaseOptions(resolved));
+    return result.found ? result.value : undefined;
+  } catch {
+    return "unavailable" as const;
+  }
+}
+
+/** Reserve immutable parsing custody, returning the exact attempt's terminal writer.
+ * The transaction and caller's synchronous owner check form the abort commit boundary.
+ * No message bytes, command authority, or user input are synthesized here.
+ */
+export function reserveChatInputAdmission(params: {
+  scope: AdmissionScope;
+  runId: string;
+  attemptId: string;
+  identity: string;
+  mode: ChatInputParsingMode;
+  assertCurrent: () => void;
+}) {
+  const resolved = resolveSqliteScope(params.scope);
+  const options = toDatabaseOptions(resolved);
+  runOpenClawAgentWriteTransaction(
+    (database) => {
+      params.assertCurrent();
+      if (
+        readSessionEntryRow(database, resolved.sessionKey)?.entry.sessionId !==
+        params.scope.sessionId
+      )
+        throw new Error("Chat admission session changed");
+      ensureTable(database.db);
+      const previous = read(database.db, resolved.sessionKey, params.runId);
+      if (
+        previous &&
+        (!valid(previous) ||
+          previous.request_identity !== params.identity ||
+          previous.parsing_mode !== params.mode ||
+          previous.aborted_at !== null ||
+          (previous.session_id !== null && previous.session_id !== params.scope.sessionId))
+      )
+        throw new Error("Chat admission identity conflicts with the accepted input");
+      executeSqliteQuerySync(
+        database.db,
+        query(database.db)
+          .insertInto(table)
+          .values({
+            session_key: resolved.sessionKey,
+            run_id: params.runId,
+            session_id: params.scope.sessionId ?? null,
+            request_identity: params.identity,
+            parsing_mode: params.mode,
+            attempt_id: params.attemptId,
+            aborted_at: null,
+            stop_reason: null,
+          })
+          .onConflict((conflict) =>
+            conflict
+              .columns(["session_key", "run_id"])
+              .doUpdateSet({ attempt_id: params.attemptId }),
+          ),
+      );
+    },
+    options,
+    { operationLabel: "session.chat-input.reserve-admission" },
+  );
+  return (endedAt: number, stopReason: string, assertOwner: () => void) =>
+    runOpenClawAgentWriteTransaction(
+      (database) => {
+        assertOwner();
+        const previous = read(database.db, resolved.sessionKey, params.runId);
+        if (
+          !previous ||
+          previous.attempt_id !== params.attemptId ||
+          previous.request_identity !== params.identity ||
+          previous.parsing_mode !== params.mode
+        )
+          throw new Error("Chat abort no longer owns admission custody");
+        // Session mutation may itself cause the interruption; bind to the original
+        // reservation rather than redirecting a terminal write to its replacement.
+        if (previous.aborted_at !== null) return;
+        executeSqliteQuerySync(
+          database.db,
+          query(database.db)
+            .updateTable(table)
+            .set({ aborted_at: endedAt, stop_reason: stopReason })
+            .where("session_key", "=", resolved.sessionKey)
+            .where("run_id", "=", params.runId)
+            .where("attempt_id", "=", params.attemptId),
+        );
+      },
+      options,
+      { operationLabel: "session.chat-input.abort-admission" },
+    );
+}
