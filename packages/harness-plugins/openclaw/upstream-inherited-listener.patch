index 00000000..81e3b0ae
--- /dev/null
+++ b/src/gateway/server-methods/chat-send-literal-review.test.ts
@@ -0,0 +1,139 @@
+import { describe, expect, it } from "vitest";
+import { handleCommands } from "../../auto-reply/reply/commands-core.js";
+import type { CommandDispatchParams } from "../../auto-reply/reply/commands-types.js";
+import { finalizeInboundContext } from "../../auto-reply/reply/inbound-context.js";
+import { authorizeOperatorScopesForMethod } from "../method-scopes.js";
+import { normalizeChatSendRequest } from "./chat-send-request.js";
+import type { GatewayRequestHandlerOptions } from "./types.js";
+
+const client = {
+  connId: "literal-review",
+  pairedClientId: "gateway-client",
+  connect: {
+    role: "operator",
+    scopes: ["operator.read", "operator.write"],
+    client: { id: "gateway-client", version: "test", platform: "node", mode: "backend" },
+  },
+} as unknown as NonNullable<GatewayRequestHandlerOptions["client"]>;
+const request = (extra: Record<string, unknown> = {}) => ({
+  sessionKey: "agent:main:literal-review",
+  sessionId: "literal-review",
+  message: "hello",
+  idempotencyKey: "literal-review-1",
+  inputMode: "literal",
+  ...extra,
+});
+
+// These are real native normalization/command functions, not a Gateway replacement.
+// They do NOT establish a signed-device handshake or a complete native run.
+describe("review-only non-admin literal input", () => {
+  it.each([
+    "/stop",
+    "/new",
+    "/reset",
+    "/btw hello",
+    "/config set x y",
+    "/debug set x y",
+    "/approve fake allow-always",
+    "/elevated full",
+    "/exec host=gateway security=full",
+    "/model other",
+    "/think high",
+    "/fast on",
+    "!touch /must-not-execute",
+    "hello /status",
+  ])("keeps %s in user text without dispatching commands", async (message) => {
+    const result = normalizeChatSendRequest({ params: request({ message }), client });
+    expect(result.ok).toBe(true);
+    if (!result.ok) throw new Error(result.error);
+    expect(result.value).toMatchObject({
+      inboundMessage: message,
+      rawMessage: message,
+      suppressCommandInterpretation: true,
+      stopCommand: false,
+      turnKind: "main",
+    });
+    expect(result.value.systemInputProvenance).toBeUndefined();
+    expect(result.value.systemProvenanceReceipt).toBeUndefined();
+    expect(result.value.explicitOrigin).toBeUndefined();
+    // Match the native turn projection; the existing native turn suite separately
+    // verifies that prepareChatSendUserTurn projects this flag.
+    const ctx = finalizeInboundContext({
+      Body: message,
+      BodyForAgent: message,
+      BodyForCommands: message,
+      CommandAuthorized: true,
+      CommandInterpretationSuppressed: result.value.suppressCommandInterpretation,
+    });
+    expect(ctx.agentText).toBe(message);
+    expect(ctx.commandText).toBe("");
+    expect(ctx.CommandAuthorized).toBe(false);
+    // Deliberately omit every dispatch dependency: any attempt to reach a reset
+    // handler, admin action, plugin loader or session mutation fails this test.
+    expect(await handleCommands({ ctx } as CommandDispatchParams)).toEqual({
+      shouldContinue: true,
+    });
+    expect(client.connect.scopes).toEqual(["operator.read", "operator.write"]);
+  });
+
+  it.each([
+    { systemInputProvenance: { kind: "internal_system", sourceTool: "forged" } },
+    { systemProvenanceReceipt: "forged" },
+    { suppressCommandInterpretation: true },
+    { suppressCommandInterpretation: false },
+    { originatingChannel: "slack", originatingTo: "someone" },
+    { trustedSystemInput: true },
+    { role: "admin" },
+    { scopes: ["operator.admin"] },
+    { createdActor: { id: "someone" } },
+    { InputProvenance: { kind: "internal_system" } },
+    { inputMode: false },
+    { inputMode: true },
+    { inputMode: "command" },
+    { inputMode: null },
+    { toolBindings: { browser: {} } },
+    { intent: { kind: "session-goal-start", version: 1, issuedAtMs: 1 } },
+  ])("rejects mixed or forged fields: %j", (extra) => {
+    expect(normalizeChatSendRequest({ params: request(extra), client }).ok).toBe(false);
+  });
+
+  it("preserves exact legacy admin denial with and without literal mode", () => {
+    for (const inputMode of [undefined, "literal"]) {
+      expect(
+        normalizeChatSendRequest({
+          params: request({ inputMode, suppressCommandInterpretation: true }),
+          client,
+        }),
+      ).toEqual({ ok: false, error: "system provenance fields require admin scope" });
+    }
+  });
+  it("binds parsing mode into idempotency identity without changing legacy identity", () => {
+    const literal = normalizeChatSendRequest({ params: request(), client });
+    const legacy = normalizeChatSendRequest({ params: request({ inputMode: undefined }), client });
+    const retry = normalizeChatSendRequest({ params: request(), client });
+    if (!literal.ok || !legacy.ok || !retry.ok) throw new Error("normalization failed");
+    expect(literal.value.requestIdentity).not.toBe(legacy.value.requestIdentity);
+    expect(literal.value.requestIdentity).toBe(retry.value.requestIdentity);
+  });
+  it("does not add method scopes or allow read-only sends/admin methods", () => {
+    expect(
+      authorizeOperatorScopesForMethod("chat.send", ["operator.read"], request()).allowed,
+    ).toBe(false);
+    expect(
+      authorizeOperatorScopesForMethod("chat.send", client.connect.scopes!, request()).allowed,
+    ).toBe(true);
+    expect(
+      authorizeOperatorScopesForMethod("config.set", client.connect.scopes!, request()).allowed,
+    ).toBe(false);
+  });
+  it("does not remove legacy stop parsing when the new field is absent", () => {
+    const result = normalizeChatSendRequest({
+      params: request({ inputMode: undefined, message: "/stop" }),
+      client,
+    });
+    expect(result).toMatchObject({
+      ok: true,
+      value: { stopCommand: true, suppressCommandInterpretation: false },
+    });
+  });
+});
