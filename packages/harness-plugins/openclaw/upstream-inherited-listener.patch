+++ b/src/gateway/server-methods/chat-send-literal-early-abort-storage.test.ts
@@ -0,0 +1,118 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import {
+  readChatInputAdmission,
+  reserveChatInputAdmission,
+  upsertSessionEntryCore,
+} from "../../config/sessions/session-accessor.js";
+import {
+  resolveSqliteScope,
+  toDatabaseOptions,
+} from "../../config/sessions/session-accessor.sqlite-scope.js";
+import { useTempSessionsFixture } from "../../config/sessions/test-helpers.js";
+import {
+  openOpenClawAgentDatabase,
+  closeOpenClawAgentDatabasesForTest,
+} from "../../state/openclaw-agent-db.js";
+import { createDirectChatContext } from "../server-chat.agent-events.test-helpers.js";
+import { pendingChatSendDedupeKey } from "../server-shared.js";
+import { resolveChatSendRequestConflict } from "./chat-send-pre-admission.js";
+import { normalizeChatSendRequest } from "./chat-send-request.js";
+
+describe("durable early admission owner", () => {
+  const fixture = useTempSessionsFixture("early-chat-admission-");
+  const scope = () => ({
+    agentId: "main",
+    sessionKey: "agent:main:early",
+    sessionId: "early-sid",
+    storePath: fixture.storePath(),
+  });
+  const database = () => openOpenClawAgentDatabase(toDatabaseOptions(resolveSqliteScope(scope())));
+  beforeEach(async () => {
+    await upsertSessionEntryCore(scope(), { sessionId: "early-sid", updatedAt: 1 });
+  });
+  afterEach(() => closeOpenClawAgentDatabasesForTest());
+  const reserve = (attemptId: string, literal = true, assertCurrent = () => {}) =>
+    reserveChatInputAdmission({
+      scope: scope(),
+      runId: "once",
+      attemptId,
+      identity: "a".repeat(64),
+      mode: literal ? "literal-v1" : "normal-v1",
+      assertCurrent,
+    });
+  it("does not migrate a legacy store merely to read missing evidence", () => {
+    expect(readChatInputAdmission(scope(), "once")).toBeUndefined();
+    expect(
+      database()
+        .db.prepare("SELECT 1 FROM sqlite_schema WHERE name = 'session_chat_input_admissions'")
+        .get(),
+    ).toBeUndefined();
+  });
+  it.each([true, false])(
+    "enforces immutable identity, exact attempt and first terminal outcome, literal=%s",
+    (literal) => {
+      const old = reserve("old", literal);
+      expect(() => reserve("opposite", !literal)).toThrow("conflicts");
+      const current = reserve("current", literal);
+      expect(() => old(10, "rpc", () => {})).toThrow("no longer owns");
+      expect(readChatInputAdmission(scope(), "once")).toMatchObject({ abortedAt: null });
+      expect(() =>
+        current(20, "rpc", () => {
+          throw new Error("owner revoked");
+        }),
+      ).toThrow("owner revoked");
+      expect(readChatInputAdmission(scope(), "once")).toMatchObject({ abortedAt: null });
+      current(30, "rpc", () => {});
+      current(40, "restart", () => {});
+      expect(readChatInputAdmission(scope(), "once")).toMatchObject({
+        abortedAt: 30,
+        stopReason: "rpc",
+      });
+      expect(() => reserve("retry", literal)).toThrow("conflicts");
+      closeOpenClawAgentDatabasesForTest();
+      expect(readChatInputAdmission(scope(), "once")).toMatchObject({
+        abortedAt: 30,
+        mode: literal ? "literal-v1" : "normal-v1",
+      });
+    },
+  );
+  it("rolls back a failed reservation without publishing a replacement owner", () => {
+    const current = reserve("first");
+    database().db.exec(
+      "CREATE TRIGGER fail_reservation BEFORE UPDATE OF attempt_id ON session_chat_input_admissions BEGIN SELECT RAISE(ABORT, 'reservation persistence failure'); END",
+    );
+    expect(() => reserve("replacement")).toThrow("reservation persistence failure");
+    database().db.exec("DROP TRIGGER fail_reservation");
+    current(10, "rpc", () => {});
+    expect(readChatInputAdmission(scope(), "once")).toMatchObject({ abortedAt: 10 });
+  });
+  it("does not redirect an old session's evidence to a new incarnation", async () => {
+    reserve("first")(10, "rpc", () => {});
+    await upsertSessionEntryCore(scope(), { sessionId: "replacement", updatedAt: 2 });
+    expect(readChatInputAdmission({ ...scope(), sessionId: "replacement" }, "once")).toBe(
+      "invalid",
+    );
+    expect(() => reserve("replacement")).toThrow("session changed");
+  });
+  it("versioned corrupt custody cannot fall through the legacy no-evidence path", () => {
+    reserve("first")(10, "rpc", () => {});
+    database().db.exec("UPDATE session_chat_input_admissions SET parsing_mode = 'literal-v999'");
+    const normalized = normalizeChatSendRequest({
+      client: null,
+      params: { sessionKey: scope().sessionKey, message: "/stop", idempotencyKey: "once" },
+    });
+    if (!normalized.ok) throw new Error("normalization failed");
+    const conflict = resolveChatSendRequestConflict({
+      request: normalized.value,
+      context: createDirectChatContext(),
+      session: {
+        ...scope(),
+        entry: { sessionId: scope().sessionId, updatedAt: 1 },
+        clientRunId: "once",
+        pendingChatSendKey: pendingChatSendDedupeKey("once"),
+        restartSafeRequest: undefined,
+      },
+    });
+    expect(conflict).toMatchObject({ details: { reason: "chat-request-conflict" } });
+  });
+});
diff --git a/src/gateway/server-methods/chat-send-literal-early-abort.test.ts b/src/gateway/server-methods/chat-send-literal-early-abort.test.ts
