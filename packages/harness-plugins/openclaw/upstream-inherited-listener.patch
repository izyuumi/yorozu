+/** Independent custody digest survives consumed source removal and rejects partial metadata.
+ * Read-only, exact SID/key; old stores are not migrated by a retry lookup.
+ */
+export function readSessionInputParsingEvidence(scope: PendingInputScope, idempotencyKey: string) {
+  try {
+    const resolved = resolveSqliteTranscriptScope(scope);
+    const result = withOpenClawAgentDatabaseReadOnly(
+      (database) =>
+        runSqliteDeferredTransactionSync(database.db, () => {
+          if (
+            readSessionEntryRow(database, resolved.sessionKey)?.entry.sessionId !==
+            resolved.sessionId
+          )
+            return undefined;
+          const db = getSessionKysely(database.db);
+          for (const table of ["session_pending_inputs", "session_input_completions"] as const) {
+            // sqlite-allow-raw -- Read-only feature-table discovery; application rows use Kysely.
+            if (
+              !database.db
+                .prepare("SELECT 1 FROM sqlite_schema WHERE type = 'table' AND name = ?")
+                .get(table)
+            )
+              continue;
+            const row = executeSqliteQueryTakeFirstSync(
+              database.db,
+              db
+                .selectFrom(table)
+                .select("request_hash")
+                .where("session_key", "=", resolved.sessionKey)
+                .where("session_id", "=", resolved.sessionId)
+                .where("idempotency_key", "=", idempotencyKey),
+            );
+            if (row) {
+              const evidence = readChatInputParsingHash(row.request_hash);
+              if (evidence !== undefined) return evidence;
+            }
+          }
+          return undefined;
+        }),
+      toDatabaseOptions(resolved),
+    );
+    return result.found ? result.value : undefined;
+  } catch {
+    // A failed read is not proof that a versioned row is absent.
+    return "unavailable" as const;
+  }
+}
