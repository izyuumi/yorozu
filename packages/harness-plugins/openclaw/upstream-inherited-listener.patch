--- /dev/null
+++ b/src/gateway/server-methods/chat-send-literal-custody.integration.test.ts
@@ -0,0 +1,216 @@
+import { execFileSync } from "node:child_process";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { buildAgentRunTerminalOutcome } from "../../agents/agent-run-terminal-outcome.js";
+import {
+  appendTranscriptMessage,
+  loadTranscriptEvents,
+  readSessionSubmittedInput,
+  upsertSessionEntryCore,
+} from "../../config/sessions/session-accessor.js";
+import {
+  stageSessionPendingInput,
+  bindSessionPendingInputSources,
+  type SessionPendingInputReceipt,
+} from "../../config/sessions/session-accessor.pending-inputs.js";
+import {
+  resolveSqliteScope,
+  toDatabaseOptions,
+} from "../../config/sessions/session-accessor.sqlite-scope.js";
+import { useTempSessionsFixture } from "../../config/sessions/test-helpers.js";
+import { buildPersistedUserTurnMessage } from "../../sessions/user-turn-transcript.message.js";
+import { closeOpenClawAgentDatabasesAsync } from "../../state/openclaw-agent-db-lifecycle.js";
+import {
+  openOpenClawAgentDatabase,
+  closeOpenClawAgentDatabasesForTest,
+} from "../../state/openclaw-agent-db.js";
+import { createDirectChatContext } from "../server-chat.agent-events.test-helpers.js";
+import { pendingChatSendDedupeKey } from "../server-shared.js";
+import { resolveChatSendRequestConflict } from "./chat-send-pre-admission.js";
+import { normalizeChatSendRequest } from "./chat-send-request.js";
+
+describe("literal source custody on real SQLite", () => {
+  const fixture = useTempSessionsFixture("literal-custody-");
+  const sessionKey = "agent:main:literal";
+  const sessionId = "literal-session";
+  const scope = () => ({ agentId: "main", sessionKey, sessionId, storePath: fixture.storePath() });
+  const receipts: SessionPendingInputReceipt[] = [];
+  beforeEach(async () => {
+    await upsertSessionEntryCore(scope(), { sessionId, updatedAt: 1 });
+  });
+  afterEach(() => {
+    for (const r of receipts.splice(0)) r.finish("interrupted");
+    closeOpenClawAgentDatabasesForTest();
+  });
+  function request(literal: boolean) {
+    const r = normalizeChatSendRequest({
+      client: null,
+      params: {
+        sessionKey,
+        sessionId,
+        message: "/stop",
+        idempotencyKey: "once",
+        ...(literal ? { inputMode: "literal" } : {}),
+      },
+    });
+    if (!r.ok) throw new Error(r.error);
+    return r.value;
+  }
+  function conflict(literal: boolean) {
+    return resolveChatSendRequestConflict({
+      request: request(literal),
+      context: createDirectChatContext(),
+      session: {
+        ...scope(),
+        entry: { sessionId, updatedAt: 1 },
+        clientRunId: "once",
+        pendingChatSendKey: pendingChatSendDedupeKey("once"),
+        restartSafeRequest: undefined,
+      },
+    });
+  }
+  it.each([
+    { literal: true, collected: false },
+    { literal: false, collected: false },
+    { literal: true, collected: true },
+    { literal: false, collected: true },
+  ])(
+    "retains symmetric parsing identity through pending, consumed, closed database and retry (%j)",
+    async ({ literal, collected }) => {
+      const r = request(literal);
+      const message = buildPersistedUserTurnMessage({
+        text: r.rawMessage,
+        timestamp: 1,
+        idempotencyKey: "once:user",
+        commandInterpretation: literal ? "literal-v1" : "normal-v1",
+        chatRequestIdentity: r.requestIdentity,
+      });
+      const options = { runId: "once", message, assertCurrent: () => {} };
+      const first = await stageSessionPendingInput(scope(), options);
+      expect(first).toBeDefined();
+      receipts.push(first!);
+      expect(readSessionSubmittedInput(scope(), "once:user")?.__openclaw).toEqual(
+        message.__openclaw,
+      );
+      expect(conflict(!literal)).toBeDefined();
+      expect(conflict(literal)).toBeUndefined();
+      let promoted = first!;
+      if (collected) {
+        const sibling = (await stageSessionPendingInput(scope(), {
+          runId: "sibling",
+          assertCurrent: () => {},
+          message: buildPersistedUserTurnMessage({
+            text: "second ordinary source",
+            timestamp: 2,
+            idempotencyKey: "sibling:user",
+          }),
+        }))!;
+        receipts.push(sibling);
+        promoted = bindSessionPendingInputSources(
+          [first!, sibling],
+          buildPersistedUserTurnMessage({
+            text: "collected inputs",
+            timestamp: 3,
+            idempotencyKey: "aggregate:user",
+          }),
+        )!;
+        receipts.push(promoted);
+      }
+      let executions = 0;
+      await promoted.run(async () => {
+        executions++;
+        await appendTranscriptMessage(scope(), { message: promoted.message });
+      });
+      for (const receipt of receipts.splice(0)) receipt.finish("interrupted");
+      await closeOpenClawAgentDatabasesAsync();
+      // A new context has no dedupe, abort or terminal cache; source evidence remains authoritative.
+      expect(conflict(!literal)).toBeDefined();
+      expect(conflict(literal)).toBeUndefined();
+      const freshProcess = JSON.parse(
+        execFileSync(
+          process.execPath,
+          [
+            "--import",
+            "./scripts/tsx.mjs",
+            "test/fixtures/chat-literal-retry-process.ts",
+            JSON.stringify({ scope: scope(), message }),
+          ],
+          { encoding: "utf8" },
+        ),
+      );
+      expect(freshProcess).toEqual({
+        evidence: { mode: literal ? "literal-v1" : "normal-v1", identity: r.requestIdentity },
+        state: "consumed",
+      });
+      const replay = await stageSessionPendingInput(scope(), options);
+      expect(replay?.state).toBe("consumed");
+      receipts.push(replay!);
+      if (replay?.state !== "consumed") executions++;
+      expect(executions).toBe(1);
+      expect(
+        (await loadTranscriptEvents(scope())).filter(
+          (e) => typeof e === "object" && e !== null && "type" in e && e.type === "message",
+        ),
+      ).toHaveLength(1);
+      expect(readSessionSubmittedInput(scope(), "once:user")?.__openclaw).toEqual(
+        message.__openclaw,
+      );
+    },
+  );
+  it.each([true, false])(
+    "retains terminal completion mode after the source row is retired (%s)",
+    async (literal) => {
+      const r = request(literal);
+      const message = buildPersistedUserTurnMessage({
+        text: r.rawMessage,
+        timestamp: 1,
+        idempotencyKey: "once:user",
+        commandInterpretation: literal ? "literal-v1" : "normal-v1",
+        chatRequestIdentity: r.requestIdentity,
+      });
+      const options = { runId: "once", message, trackCompletion: true, assertCurrent: () => {} };
+      const first = (await stageSessionPendingInput(scope(), options))!;
+      receipts.push(first);
+      first.complete!(buildAgentRunTerminalOutcome({ status: "ok" }));
+      first.finish("interrupted");
+      receipts.pop();
+      await closeOpenClawAgentDatabasesAsync();
+      expect(readSessionSubmittedInput(scope(), "once:user")).toBeUndefined();
+      expect(conflict(!literal)).toBeDefined();
+      expect(conflict(literal)).toBeUndefined();
+      const replay = (await stageSessionPendingInput(scope(), options))!;
+      receipts.push(replay);
+      expect(replay.state).toBe("consumed");
+      expect(() =>
+        replay.run(() => {
+          throw new Error("MUST NOT EXECUTE");
+        }),
+      ).toThrow("already completed");
+    },
+  );
+  it.each([true, false])(
+    "fails closed for damaged required parsing metadata in retained custody (%s)",
+    async (literal) => {
+      const r = request(literal);
+      const message = buildPersistedUserTurnMessage({
+        text: r.rawMessage,
+        timestamp: 1,
+        idempotencyKey: "once:user",
+        commandInterpretation: literal ? "literal-v1" : "normal-v1",
+        chatRequestIdentity: r.requestIdentity,
+      });
+      const first = (await stageSessionPendingInput(scope(), {
+        runId: "once",
+        message,
+        assertCurrent: () => {},
+      }))!;
+      receipts.push(first);
+      const database = openOpenClawAgentDatabase(toDatabaseOptions(resolveSqliteScope(scope())));
+      const damaged = { ...message, __openclaw: {} };
+      database.db
+        .prepare("UPDATE session_pending_inputs SET message_json = ? WHERE input_id = ?")
+        .run(JSON.stringify(damaged), first.inputId);
+      expect(conflict(literal)).toBeDefined();
+      expect(conflict(!literal)).toBeDefined();
+    },
+  );
+});
