@@ -0,0 +1,297 @@
+import { execFileSync } from "node:child_process";
+import { describe, expect, it, vi } from "vitest";
+import { createDeferred } from "../../../test/helpers/promise.js";
+import { registerAgentSessionLoopTestLifecycle } from "../../agents/sessions/agent-session-loop-correctness.test-support.js";
+import { getRuntimeConfig } from "../../config/config.js";
+import {
+  readChatInputAdmission,
+  readSessionSubmittedInput,
+} from "../../config/sessions/session-accessor.js";
+import {
+  resolveSqliteScope,
+  toDatabaseOptions,
+} from "../../config/sessions/session-accessor.sqlite-scope.js";
+import * as lifecycle from "../../sessions/session-lifecycle-admission.js";
+import { closeOpenClawAgentDatabasesAsync } from "../../state/openclaw-agent-db-lifecycle.js";
+import { openOpenClawAgentDatabase } from "../../state/openclaw-agent-db.js";
+import {
+  createGatewaySchedulerClock,
+  createTestGatewayScheduler,
+} from "../../test-utils/gateway-scheduler-clock.js";
+import { createDirectChatContext } from "../server-chat.agent-events.test-helpers.js";
+import { DEDUPE_MAX, DEDUPE_TTL_MS } from "../server-constants.js";
+import { startGatewayMaintenanceTimers } from "../server-maintenance.js";
+import { pendingChatSendDedupeKey } from "../server-shared.js";
+import { installGatewayTestHooks, dispatchInboundMessageMock } from "../test-helpers.js";
+import { createGatewayMaintenanceStateForTest } from "../test-helpers.maintenance-state.js";
+import { writePreRegisteredChatAbort } from "./chat-abort-authorization.js";
+import { handleChatAbortRequest } from "./chat-abort-handler.js";
+import { handleChatSend } from "./chat-send-handler.js";
+import { useBrowserFollowupFixture } from "./chat-send-pending-inputs.test-support.js";
+installGatewayTestHooks();
+registerAgentSessionLoopTestLifecycle();
+const createFixture = useBrowserFollowupFixture();
+
+describe("early abort parsing custody at the handler boundary", () => {
+  it.each(
+    [true, false].flatMap((literal) =>
+      ["expiry", "eviction", "restart"].map((retire) => ({ literal, retire })),
+    ),
+  )("retains symmetric custody before staging: %j", async ({ literal, retire }) => {
+    const f = await createFixture({ preserveContent: true });
+    f.client.connect.scopes = ["operator.read", "operator.write"];
+    f.params.message = literal ? "/stop" : "/status";
+    if (literal) f.params.inputMode = "literal";
+    const entered = createDeferred();
+    const release = createDeferred();
+    const original = lifecycle.beginSessionWorkAdmission;
+    const gate = vi
+      .spyOn(lifecycle, "beginSessionWorkAdmission")
+      .mockImplementationOnce(async (p) => {
+        entered.resolve();
+        await release.promise;
+        return original(p);
+      });
+    const sending = f.send();
+    try {
+      await entered.promise;
+      expect(readSessionSubmittedInput(f.scope, `${f.params.idempotencyKey}:user`)).toBeUndefined();
+      const abortParams = { sessionKey: f.params.sessionKey, runId: f.params.idempotencyKey };
+      const aborted = vi.fn();
+      await handleChatAbortRequest({
+        params: abortParams,
+        req: { type: "req", id: "abort", method: "chat.abort", params: abortParams },
+        client: f.client,
+        context: f.context,
+        respond: aborted,
+        isWebchatConnect: () => true,
+      });
+      expect(aborted).toHaveBeenCalledWith(true, expect.objectContaining({ aborted: true }));
+      expect(readChatInputAdmission(f.scope, f.params.idempotencyKey)).toMatchObject({
+        mode: literal ? "literal-v1" : "normal-v1",
+        abortedAt: expect.any(Number),
+      });
+      release.resolve();
+      await sending;
+      gate.mockRestore();
+      expect(dispatchInboundMessageMock).not.toHaveBeenCalled();
+      let context = f.context;
+      if (retire !== "restart") {
+        const now = Date.now();
+        const clock = createGatewaySchedulerClock(now);
+        const scheduler = createTestGatewayScheduler(clock.clock);
+        const scheduled = vi.spyOn(scheduler, "schedule");
+        const maintenance = startGatewayMaintenanceTimers({
+          ...createGatewayMaintenanceStateForTest(),
+          scheduler,
+          dedupe: context.dedupe,
+          chatRunState: context.chatRunState,
+          chatAbortControllers: context.chatAbortControllers,
+        });
+        try {
+          if (retire === "expiry") {
+            clock.setTime(now + DEDUPE_TTL_MS + 60_000);
+          } else {
+            for (let i = 0; i < DEDUPE_MAX; i++)
+              context.dedupe.set(`unrelated:${i}`, { ts: now + i + 1, ok: true });
+          }
+          const dedupeTick = scheduled.mock.calls.find(
+            ([job]) => job.id === "maintenance:dedupe",
+          )?.[0];
+          expect(dedupeTick).toBeDefined();
+          await dedupeTick!.run();
+          expect(context.dedupe.has(`chat:${f.params.idempotencyKey}`)).toBe(false);
+          expect(context.chatRunState.hasAbortMarker(f.params.idempotencyKey)).toBe(true);
+          // Capacity coverage also removes all markers: SQLite alone must suffice.
+          if (retire === "eviction") context.chatRunState.runs.clear();
+        } finally {
+          await maintenance.stopPeriodicTasks();
+          await maintenance.skillUsageCleanup();
+          scheduled.mockRestore();
+        }
+      } else {
+        f.context.dedupe.clear();
+        f.context.chatRunState.runs.clear();
+        await closeOpenClawAgentDatabasesAsync();
+        execFileSync(
+          process.execPath,
+          [
+            "node_modules/vitest/vitest.mjs",
+            "run",
+            "--config",
+            "test/fixtures/chat-early-abort-restart.vitest.config.ts",
+          ],
+          {
+            encoding: "utf8",
+            env: {
+              ...process.env,
+              CHAT_EARLY_ABORT_FIXTURE: JSON.stringify({
+                scope: f.scope,
+                params: f.params,
+                client: f.client,
+              }),
+            },
+          },
+        );
+        context = createDirectChatContext({ getRuntimeConfig, chatQueuedTurns: new Map() });
+      }
+      const retry = async () => {
+        const respond = vi.fn();
+        await handleChatSend({
+          params: f.params,
+          req: { type: "req", id: "retry", method: "chat.send", params: f.params },
+          context,
+          client: f.client,
+          respond,
+          isWebchatConnect: () => true,
+        });
+        return respond;
+      };
+      const replay = await retry();
+      expect(replay).toHaveBeenCalledWith(
+        true,
+        expect.objectContaining({ status: "timeout", summary: "aborted" }),
+        undefined,
+        expect.anything(),
+      );
+      if (literal) delete f.params.inputMode;
+      else f.params.inputMode = "literal";
+      const conflict = await retry();
+      expect(conflict).toHaveBeenCalledWith(
+        false,
+        undefined,
+        expect.objectContaining({ details: { reason: "chat-request-conflict" } }),
+      );
+      // An absent-mode /stop must not acquire stop effects under either original mode.
+      delete f.params.inputMode;
+      f.params.message = "/stop";
+      const stop = await retry();
+      expect(stop).toHaveBeenCalledWith(
+        false,
+        undefined,
+        expect.objectContaining({ details: { reason: "chat-request-conflict" } }),
+      );
+      expect(dispatchInboundMessageMock).not.toHaveBeenCalled();
+      expect(f.activeRun?.abortSignal.aborted).toBe(false);
+      expect(readSessionSubmittedInput(f.scope, `${f.params.idempotencyKey}:user`)).toBeUndefined();
+    } finally {
+      release.resolve();
+      await sending;
+      gate.mockRestore();
+      await f.cleanup();
+    }
+  });
+
+  it.each([true, false])(
+    "terminalizes an expired pending reservation using its retained durable owner, literal=%s",
+    async (literal) => {
+      const f = await createFixture({ preserveContent: true });
+      f.params.message = literal ? "/stop" : "/status";
+      if (literal) f.params.inputMode = "literal";
+      const entered = createDeferred();
+      const release = createDeferred();
+      const original = lifecycle.beginSessionWorkAdmission;
+      const gate = vi
+        .spyOn(lifecycle, "beginSessionWorkAdmission")
+        .mockImplementationOnce(async (p) => {
+          entered.resolve();
+          await release.promise;
+          return original(p);
+        });
+      const sending = f.send();
+      try {
+        await entered.promise;
+        f.context.dedupe.delete(pendingChatSendDedupeKey(f.params.idempotencyKey));
+        release.resolve();
+        expect(await sending).toHaveBeenCalledWith(
+          true,
+          expect.objectContaining({ status: "timeout", summary: "aborted" }),
+          undefined,
+          expect.anything(),
+        );
+        expect(readChatInputAdmission(f.scope, f.params.idempotencyKey)).toMatchObject({
+          abortedAt: expect.any(Number),
+        });
+        f.context.dedupe.clear();
+        f.context.chatRunState.runs.clear();
+        expect(await f.send()).toHaveBeenCalledWith(
+          true,
+          expect.objectContaining({ summary: "aborted" }),
+          undefined,
+          expect.anything(),
+        );
+        expect(dispatchInboundMessageMock).not.toHaveBeenCalled();
+      } finally {
+        release.resolve();
+        await sending;
+        gate.mockRestore();
+        await f.cleanup();
+      }
+    },
+  );
+
+  it("does not acknowledge, retire custody, or publish RAM abort on persistence failure", async () => {
+    const f = await createFixture({ preserveContent: true });
+    f.params.inputMode = "literal";
+    f.params.message = "/stop";
+    const entered = createDeferred();
+    const release = createDeferred();
+    const original = lifecycle.beginSessionWorkAdmission;
+    const gate = vi
+      .spyOn(lifecycle, "beginSessionWorkAdmission")
+      .mockImplementationOnce(async (p) => {
+        entered.resolve();
+        await release.promise;
+        return original(p);
+      });
+    const sending = f.send();
+    try {
+      await entered.promise;
+      const key = pendingChatSendDedupeKey(f.params.idempotencyKey);
+      const pending = f.context.dedupe.get(key)!;
+      const database = openOpenClawAgentDatabase(toDatabaseOptions(resolveSqliteScope(f.scope)));
+      database.db.exec(
+        "CREATE TRIGGER fail_early_abort BEFORE UPDATE OF aborted_at ON session_chat_input_admissions BEGIN SELECT RAISE(ABORT, 'fixture persistence failure'); END",
+      );
+      expect(() =>
+        writePreRegisteredChatAbort({
+          context: f.context,
+          runId: f.params.idempotencyKey,
