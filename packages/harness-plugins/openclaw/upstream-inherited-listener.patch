@@ -0,0 +1,130 @@
+import { describe, expect, it, vi } from "vitest";
+import { registerAgentSessionLoopTestLifecycle } from "../../agents/sessions/agent-session-loop-correctness.test-support.js";
+import { readSessionSubmittedInput } from "../../config/sessions/session-accessor.js";
+import { installGatewayTestHooks, dispatchInboundMessageMock } from "../test-helpers.js";
+import type { ChatSendExternalAuthorityAdmission } from "./chat-send-external-authority-contract.js";
+import { handleChatSend } from "./chat-send-handler.js";
+import { useBrowserFollowupFixture } from "./chat-send-pending-inputs.test-support.js";
+import { resolveGatewayChatCronCreatorAuthorityAdmission } from "./cron-creator-authority-admission.js";
+installGatewayTestHooks();
+registerAgentSessionLoopTestLifecycle();
+const createFixture = useBrowserFollowupFixture();
+describe("literal authenticated user handler", () => {
+  it.each([false, true])(
+    "keeps the ordinary nonadmin authority ceiling, literal=%s",
+    async (literal) => {
+      const f = await createFixture({ preserveContent: true, persistDuringDispatch: true });
+      f.client.connect.scopes = ["operator.read", "operator.write"];
+      f.client.connect.client = { id: "cli", mode: "cli", platform: "test", version: "test" };
+      f.params.message = literal ? "/stop" : "ordinary user text";
+      if (literal) f.params.inputMode = "literal";
+      const resolve = vi.fn<ChatSendExternalAuthorityAdmission["resolve"]>((p) => {
+        const admission = resolveGatewayChatCronCreatorAuthorityAdmission({
+          ...p,
+          resolvedSessionKey: p.sessionKey,
+          isIncognito: p.isIncognitoEntry,
+          isDirectExternalUser: true,
+        });
+        expect(admission).toBeUndefined();
+        return undefined;
+      });
+      const authority: ChatSendExternalAuthorityAdmission = {
+        resolve,
+        allowsDashboardReads: () => false,
+        run: (_capability, run) => run(),
+      };
+      const respond = vi.fn();
+      try {
+        await handleChatSend(
+          {
+            req: { type: "req", id: "literal", method: "chat.send", params: f.params },
+            params: f.params,
+            client: f.client,
+            context: f.context,
+            respond,
+            isWebchatConnect: () => false,
+          },
+          undefined,
+          authority,
+        );
+        expect(resolve).toHaveBeenCalledWith(
+          expect.objectContaining({ isSystemGenerated: false, inputProvenance: undefined }),
+        );
+        expect(resolve.mock.results[0]?.value).toBeUndefined(); // no Cron creator/operator elevation
+        expect(respond).toHaveBeenCalledWith(
+          true,
+          expect.objectContaining({ status: "started" }),
+          undefined,
+          expect.anything(),
+        );
+        const recorder = await f.dispatchedRecorder;
+        expect(recorder.getPendingInputMessage?.()?.__openclaw).toMatchObject({
+          commandInterpretation: literal ? "literal-v1" : "normal-v1",
+        });
+        const dispatched = dispatchInboundMessageMock.mock.calls[0]?.[0];
+        expect(dispatched?.ctx.CommandInterpretationSuppressed).toBe(literal ? true : undefined);
+        expect(dispatched?.ctx.InputProvenance).toBeUndefined();
+        await f.finishDispatch();
+        expect(
+          readSessionSubmittedInput(f.scope, `${f.params.idempotencyKey}:user`)?.__openclaw,
+        ).toMatchObject({ commandInterpretation: literal ? "literal-v1" : "normal-v1" });
+        const count = dispatchInboundMessageMock.mock.calls.length;
+        f.context.dedupe.clear();
+        const retry = await f.send();
+        expect(retry).toHaveBeenCalledWith(
+          true,
+          expect.objectContaining({ status: "ok" }),
+          undefined,
+          expect.anything(),
+        );
+        expect(dispatchInboundMessageMock).toHaveBeenCalledTimes(count);
+        if (literal) {
+          delete f.params.inputMode;
+          const mismatch = await f.send();
+          expect(mismatch).toHaveBeenCalledWith(
+            false,
+            undefined,
+            expect.objectContaining({ details: { reason: "chat-request-conflict" } }),
+          );
+          expect(dispatchInboundMessageMock).toHaveBeenCalledTimes(count);
+        }
+      } finally {
+        await f.cleanup();
+      }
+    },
+  );
+  it.each([
+    "readonly",
+    "node",
+    "wrong-sid",
+    "missing-session",
+    "wrong-cas",
+    "protected-suppression",
+    "forged-role",
+  ] as const)("keeps literal admission fail-closed before dispatch: %s", async (denial) => {
+    const f = await createFixture({ preserveContent: true });
+    f.client.connect.scopes = ["operator.read", "operator.write"];
+    f.client.connect.client = { id: "cli", mode: "cli", platform: "test", version: "test" };
+    f.params.inputMode = "literal";
+    f.params.message = "/stop";
+    if (denial === "readonly") f.client.connect.scopes = ["operator.read"];
+    if (denial === "node") f.client.connect.role = "node";
+    if (denial === "wrong-sid") f.params.sessionId = "different-session";
+    if (denial === "missing-session") f.params.sessionKey = "agent:main:literal-not-created";
+    if (denial === "wrong-cas") f.params.expectedLeafEntryId = "different-leaf";
+    if (denial === "protected-suppression") f.params.suppressCommandInterpretation = true;
+    if (denial === "forged-role") Object.assign(f.params, { role: "system" });
+    try {
+      const respond = await f.send(vi.fn(), {});
+      expect(respond).toHaveBeenCalledWith(
+        false,
+        undefined,
+        expect.objectContaining({ code: denial === "readonly" ? "FORBIDDEN" : "INVALID_REQUEST" }),
+      );
+      expect(dispatchInboundMessageMock).not.toHaveBeenCalled();
+      expect(readSessionSubmittedInput(f.scope, `${f.params.idempotencyKey}:user`)).toBeUndefined();
+    } finally {
+      await f.cleanup();
+    }
+  });
+});
