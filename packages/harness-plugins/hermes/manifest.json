{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "pluginId": "hermes",
  "version": "0.21.5",
  "entry": "adapter.mjs",
  "upstream": {
    "version": "0.21.5",
    "sourceSha": "f97608f178d1ffeca59860195ab7da295f7c8e5f"
  },
  "runtime": {
    "kind": "external-python",
    "entry": "bootstrap.py",
    "python": ">=3.11,<3.14"
  },
  "productionReady": false,
  "permissionEnforcement": "product-scope-requires-host-macos-seatbelt; native-approvals-remain-heuristic",
  "agentScope": {
    "requiredForProduct": true,
    "isolationBackend": "macos-seatbelt-v1",
    "nativeToolsets": [
      "file",
      "terminal",
      "delegation",
      "memory",
      "web",
      "browser"
    ],
    "platformToolsets": [
      "agent-messaging"
    ],
    "profileOwner": "persistent-agent",
    "multipleConversations": false,
    "productConversation": "single-continuous; legacy native sessions remain readable"
  },
  "capabilities": {
    "backgroundTasks": true,
    "targetedSteer": true,
    "taskStop": true,
    "approvals": true,
    "reconnect": false,
    "attachments": false,
    "crashAutoResume": false,
    "schedules": false,
    "nativeComputerUse": false,
    "teamDelegation": false
  },
  "authentication": {
    "subscriptionAccess": "unsupported-pending-fresh-onboarding",
    "siwc": false,
    "ambientCredentials": false,
    "billedFallback": false,
    "localProofProvider": "explicit-loopback-native-responses"
  },
  "extensions": {
    "version": 1,
    "connectedLifecycle": false,
    "conversationActions": true,
    "autonomousEvents": false,
    "agentMessaging": true
  }
}
